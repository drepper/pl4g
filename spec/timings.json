{
  "samples": {
    "exit0": "the smallest conforming program",
    "global-variable": "one variable, read once",
    "assign-widths": "a store of every width",
    "many-values-at-once": "four values live at once, which the allocator places",
    "unreached-function": "a function and a variable that are dropped",
    "export-visibility": "several definitions, some exported",
    "digit-separators": "literals in every base",
    "boolean-values": "truth values in both sections",
    "bitwise-operators": "an expression with four operators and two variables",
    "bitwise-precedence": "an expression the folder collapses entirely",
    "spill-to-the-frame": "thirty-two at once, which no target can hold",
    "boolean-in-memory": "a truth value, which is one byte",
    "comparison-operators": "all six comparisons, none of them folded",
    "logic-operators": "all six logical operators, none of them folded",
    "logic-short-circuit": "three short circuits, which is six blocks",
    "saturating-precedence": "a sum and a product that saturate",
    "arithmetic-operators": "a sum and a product that check and can fault",
    "semicolon-separates-statements": "two statements on one line",
    "call-nested": "four calls, two of them nested",
    "arithmetic-division": "a division and a remainder, each checked twice",
    "shift-operators": "two shifts, each with its distance checked",
    "float-arithmetic": "ten floating-point answers, each asserted"
  },
  "commits": [
    {
      "hash": "eee64a3",
      "subject": "✨ A register allocator, by linear scan, which does not spill"
    },
    {
      "hash": "af657ad",
      "subject": "✨ Conditional branches, selected with their comparison and turned round"
    },
    {
      "hash": "2f564cb",
      "subject": "✨ Expressions, by precedence climbing, with the bitwise operators"
    },
    {
      "hash": "37dbb28",
      "subject": "🐛 A diagnostic number no block covers is refused, not mis-grouped"
    },
    {
      "hash": "1c4ae78",
      "subject": "✨ What the compiler leaves out is recorded in the decision log"
    },
    {
      "hash": "f391839",
      "subject": "✨ A local the sweep removes is logged too, by the name it was given"
    },
    {
      "hash": "04c20c9",
      "subject": "✨ A grammar for editors, and a program that shows a log against its source"
    },
    {
      "hash": "3020cf6",
      "subject": "✨ Spilling to a stack frame, by rewriting and starting again"
    },
    {
      "hash": "9bcaf84",
      "subject": "⚡ A spilled value is read from the frame once for as many instructions as read it"
    },
    {
      "hash": "40c35bb",
      "subject": "📝 Timing tables grow down, not across, and are grouped"
    },
    {
      "hash": "9437d8a",
      "subject": "✨ Modules: read while compiling, read once, named by the shortest route"
    },
    {
      "hash": "d0c8cf5",
      "subject": "✨ `export` and `visible` are two attributes, because they were two questions"
    },
    {
      "hash": "73ce857",
      "subject": "✨ One meaning, one spelling: attributes are written one way"
    },
    {
      "hash": "ed1c028",
      "subject": "✨ A truth value in a register, on all three architectures"
    },
    {
      "hash": "1269bd5",
      "subject": "✨ The comparisons: `=` `≠` `<` `>` `≤` `≥`"
    },
    {
      "hash": "db0b436",
      "subject": "✨ A statement's value must be used, and ≠ keeps its glyph"
    },
    {
      "hash": "25bb4e0",
      "subject": "✨ The logical operators, and block parameters to carry `and` and `or`"
    },
    {
      "hash": "baf1f3c",
      "subject": "✨ Constants of any width, and the header flags they travel under"
    },
    {
      "hash": "74ac227",
      "subject": "✨ Saturating arithmetic: ⊞ ⊟ ⊠"
    },
    {
      "hash": "c0f29f2",
      "subject": "✨ Arithmetic that checks, and the path a fault leaves through"
    },
    {
      "hash": "5c3aec4",
      "subject": "✨ No arrow means nothing answered with; a semicolon separates and never ends"
    },
    {
      "hash": "f7ba2fc",
      "subject": "✅ A call that answers with nothing has nothing to use"
    },
    {
      "hash": "3e9eb27",
      "subject": "✨ Function calls, with positional arguments"
    },
    {
      "hash": "0990c74",
      "subject": "✨ Division and what is left over: `÷` and `%`"
    },
    {
      "hash": "05d8da1",
      "subject": "✨ Moving bits sideways: « » ↺ ↻, and an overflow seen while compiling"
    },
    {
      "hash": "03887ff",
      "subject": "📝 Time the floating-point sample too"
    }
  ],
