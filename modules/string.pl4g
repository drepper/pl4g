※ -- digits -------------------------------------------------------------------

※※ The value of a digit, in any base up to thirty-six.
※※
※※ \details `0` to `9` are nought to nine, and the letters, small or capital, ten
※※ to thirty-five: what a digit in base sixteen is, and what the four digits of
※※ JSON's `\u` escape are each.  Whether the value is a digit of the base in hand
※※ is the caller's comparison to make.
※※
※※ \param c the byte
※※ \return its value, or nothing where it is no digit of any base
※
※ Two subtractions and two comparisons, and no table: the small letters are the
※ capitals with one bit more, so one `|` asks about both.
@[export]
fn digit_value(c: u8) → u8?:
    let decimal: u8 = ⎕wrap(c - 48u8)
    if decimal < 10u8:
        return decimal
    let letter: u8 = ⎕wrap((c | 32u8) - 97u8)
    if letter < 26u8: letter + 10u8 else: ⊥

※ Whether a byte is a decimal digit.
fn is_digit(c: u8) → bool:
    ⎕wrap(c - 48u8) < 10u8

※ Whether `flag` is among `allow`.
fn allows(allow: Allow, flag: Allow) → bool:
    (allow & flag) = flag

※ -- whole numbers ------------------------------------------------------------

※※ A whole number at the start of some bytes, in any whole-number type.
※※
※※ \details A `-` in front, or with `Allow.plus` a `+`, and then the digits of
※※ *base*: `0` to `9`, and from base eleven on the letters, small or capital.
※※ With `Allow.hex`, `0x` or `0X` in front of the digits makes them hexadecimal
※※ whatever *base* says; with `Allow.underscores` a `_` may stand between two
※※ digits.  In base ten a number of more than one digit does not begin with
※※ nought, which is JSON's rule, unless `Allow.loose` says it may.  Reading stops
※※ at the first byte that cannot go on, which is the caller's to look at: `12,`
※※ is twelve, and two bytes.
※※
※※ The type is handed, `parse_int(b, ⌜u16⌝)`, and every one of them is read the
※※ same way: what does not fit it is `out_of_range`, a minus in front of an
※※ unsigned type among it unless what follows is nought.
※※
※※ \param bytes what to read, from its first byte
※※ \param kind the type to read a number of
※※ \param base how many digits a place has
※※ \param allow what is read besides JSON's grammar
※※ \return the number, and how many bytes it took
※※ \raises `absent` where no number begins the bytes, `malformed` where a sign or a
※※ prefix has no digits after it or a number begins with a nought it may not, and
※※ `out_of_range` where it is too large or too small for the type
※
※ The digits are gathered in a `u64` whatever the type, each step asking the
※ whole product whether it still fits -- one multiplication on every machine --
※ and the type is asked once, at the end, by narrowing.  A sign in front is a
※ flag beside the magnitude, so the smallest `i64` is read as the magnitude it
※ has and nothing is negated that cannot be.
@[export]
fn parse_int(bytes: u8⟦⟧, kind: ⌜T'⌝, base: u8 ← 10u8,
             allow: Allow ← Allow.json) → Parsed(T') ? ParseError
        pre(base ≥ 2u8 ∧ base ≤ 36u8):
    let n: u64 ¤idx = #bytes
    if n = 0:
        return ⊥ ParseError.absent
    let at: mut u64 ¤idx = 0
    let first: u8 = bytes⟦0⟧
    let negative: bool = first = 45u8
    if negative ∨ (first = 43u8 ∧ allows(allow, Allow.plus)):
        at ← 1
    let radix: mut u64 = ⎕widen(base, ⌜u64⌝)
    ※ `0x` with no digit after it is a nought followed by something else, as C
    ※ reads it
    if (allows(allow, Allow.hex) and at + 2 < n and bytes⟦at⟧ = 48u8
            and (bytes⟦at + 1⟧ | 32u8) = 120u8 and (digit_value(bytes⟦at + 2⟧) ?? 255u8) < 16u8):
        radix ← 16u64
        at ← at + 2
    let begin: u64 ¤idx = at
    let separated: bool = allows(allow, Allow.underscores)
    let magnitude: mut u64 = 0u64
    while §digits at < n:
        let c: u8 = bytes⟦at⟧
        let d: u64 = ⎕widen(digit_value(c) ?? 255u8, ⌜u64⌝)
        if d < radix:
            let product: 〈u64, u64〉 = ⎕wide_mul(magnitude, radix)
            let sum: u64 = ⎕wrap(product⟦1⟧ + d)
            if product⟦0⟧ ≠ 0u64 ∨ sum < d:
                return ⊥ ParseError.out_of_range
            magnitude ← sum
            at ← at + 1
        elif (separated and c = 95u8 and at > begin and at + 1 < n
                and ⎕widen(digit_value(bytes⟦at + 1⟧) ?? 255u8, ⌜u64⌝) < radix):
            at ← at + 1
        else:
            break §digits
    if at = begin:
        return ⊥ (if begin = 0: ParseError.absent else: ParseError.malformed)
    if (radix = 10u64 and bytes⟦begin⟧ = 48u8 and at > begin + 1
            and ¬allows(allow, Allow.loose)):
        return ⊥ ParseError.malformed
    match narrowed(magnitude, negative, ⌜T'⌝):
        T'(value):
            Parsed(.value ← value, .end ← at)
        ⊥(why):
            ⊥ why

※ A magnitude and a sign as a number of the type handed, where it has one.
※
※ Everything but a `u64` fits an `i64`, so the signed number is made there and
※ narrowed; a `u64` is the magnitude itself.
fn narrowed(magnitude: u64, negative: bool, kind: ⌜T'⌝) → T' ? ParseError:
    comptime if ⌜T'⌝ = ⌜u64⌝:
        if negative ∧ magnitude ≠ 0u64:
            return ⊥ ParseError.out_of_range
        magnitude
    else:
        let limit: u64 = if negative: 9223372036854775808u64 else: 9223372036854775807u64
        if magnitude > limit:
            return ⊥ ParseError.out_of_range
        ※ -(m - 1) - 1 is -m, and has no step that does not fit: the magnitude of
        ※ the smallest i64 is one more than the largest.
        let signed: i64 = if negative ∧ magnitude ≠ 0u64:
            ⁻1i64 - (⎕narrow(magnitude - 1u64, ⌜i64⌝) ?? 0i64)
        else:
            ⎕narrow(magnitude, ⌜i64⌝) ?? 0i64
        match ⎕narrow(signed, ⌜T'⌝):
            T'(value):
                value
            ⊥(why):
                ⊥ ParseError.out_of_range

※ -- floating-point numbers ---------------------------------------------------

※※ An `f64` at the start of some bytes: the one nearest the decimal number they
※※ write, a tie going to the even one.
※※
※※ \details JSON's grammar -- a `-`, digits with no nought in front of others, a
※※ point and digits, an `e` or `E`, a sign and digits -- and what *allow* adds to it.
※※ Reading stops at the first byte that cannot go on, so `1.5]` is one and a half
※※ and three bytes.  The answer is correctly rounded whatever the number: every
※※ digit counts, however many there are, and a number written as the exact half
※※ between two `f64` goes to the one whose last bit is nought.  A number too
※※ small for any but nought is nought, with its sign; one too large for any is
※※ `out_of_range`, since an infinity is no number this language computes with.
※※ With `Allow.special`, `inf`, `infinity` and `nan` are the infinity and the
※※ not-a-number, which only `⎕from_bits` otherwise makes.
※※
※※ \param bytes what to read, from its first byte
※※ \param allow what is read besides JSON's grammar
※※ \return the number, and how many bytes it took
※※ \raises `absent` where nothing that begins a number is there, `malformed` where a
※※ number is broken off, and `out_of_range` where it is beyond the largest `f64`
※
※ Three ways to the answer, the cheap ones first.  The digits are gathered into a
※ `u64` while there are no more than nineteen that count, and the exponent says
※ where the point was.  **Clinger's**: a significand below 2^53 is exact as an
※ `f64`, and so is every power of ten up to 10^22, so where both are, one
※ multiplication or division rounds once and is the answer.  **Eisel and
※ Lemire's**: the significand times a 128-bit power of five, the upper half of
※ which holds the answer's bits and says where to round them -- proved by Mushtak
※ and Lemire to settle every significand of nineteen digits.  And where there
※ were more, the digits left out may move the answer: it is worked out for the
※ nineteen and for one more than them, and where the two differ an **exact
※ comparison** of big integers decides between the neighbours, as fast_float's
※ `digit_comp` does.
@[export]
fn parse_f64(bytes: u8⟦⟧, allow: Allow ← Allow.json) → Parsed(f64) ? ParseError:
    let n: u64 ¤idx = #bytes
    if n = 0:
        return ⊥ ParseError.absent
    let at: mut u64 ¤idx = 0
    let first: u8 = bytes⟦0⟧
    let negative: bool = first = 45u8
    if negative ∨ (first = 43u8 ∧ allows(allow, Allow.plus)):
        at ← 1
    let sign: u64 = if negative: 0x8000000000000000u64 else: 0u64
    if at < n and allows(allow, Allow.special) and (bytes⟦at⟧ | 32u8) ≥ 97u8:
        return special(bytes, at, sign)
    if (allows(allow, Allow.hex) and at + 2 < n and bytes⟦at⟧ = 48u8
            and (bytes⟦at + 1⟧ | 32u8) = 120u8 and hex_digits_at(bytes, at + 2)):
        return hex_float(bytes, at + 2, sign, allow)
    let begin: u64 ¤idx = at
    let separated: bool = allows(allow, Allow.underscores)
    let loose: bool = allows(allow, Allow.loose)
    ※ Every digit goes into `w`, which is right while there are no more than
    ※ nineteen that count -- and nothing here asks whether it fits, which is what
    ※ keeps the loop to a load, a comparison and a multiplication.  How many
    ※ there were is told by where the loops stopped.
    let w: mut u64 = 0u64
    let skipped: mut u64 ¤idx = 0
    while §whole at < n:
        let d: u8 = ⎕wrap(bytes⟦at⟧ - 48u8)
        if d < 10u8:
            w ← ⎕wrap(w × 10u64 + ⎕widen(d, ⌜u64⌝))
            at ← ⎕wrap(at + 1)
        elif separated and separator(bytes, at, begin):
            at ← at + 1
            skipped ← skipped + 1
        else:
            break §whole
    let whole: u64 ¤idx = at - begin
    if whole = 0 and ¬(loose and at + 1 < n and bytes⟦at⟧ = 46u8 and is_digit(bytes⟦at + 1⟧)):
        return ⊥ (if at = 0: ParseError.absent else: ParseError.malformed)
    if whole > 1 and bytes⟦begin⟧ = 48u8 and ¬loose:
        return ⊥ ParseError.malformed
    let digits: mut u64 ¤idx = whole - skipped
    let fraction: mut u64 ¤idx = 0
    if at < n and bytes⟦at⟧ = 46u8:
        at ← at + 1
        let from: u64 ¤idx = at
        let separators: mut u64 ¤idx = 0
        while §fraction at < n:
            let d: u8 = ⎕wrap(bytes⟦at⟧ - 48u8)
            if d < 10u8:
                w ← ⎕wrap(w × 10u64 + ⎕widen(d, ⌜u64⌝))
                at ← ⎕wrap(at + 1)
            elif separated and separator(bytes, at, from):
                at ← at + 1
                separators ← separators + 1
            else:
                break §fraction
        if at = from and ¬loose:
            return ⊥ ParseError.malformed
        fraction ← at - from - separators
        digits ← digits + fraction
    let exponent: mut i64 = 0i64 - (⎕narrow(⎕drop(fraction), ⌜i64⌝) ?? 0i64)
    let mantissa_end: u64 ¤idx = at
    if at < n and (bytes⟦at⟧ | 32u8) = 101u8:
        let mark: u64 ¤idx = at
        at ← at + 1
        let down: bool = at < n and bytes⟦at⟧ = 45u8
        if at < n and (down ∨ bytes⟦at⟧ = 43u8):
            at ← at + 1
        let from: u64 ¤idx = at
        let power: mut i64 = 0i64
        while §power at < n:
            let d: u8 = ⎕wrap(bytes⟦at⟧ - 48u8)
            if d < 10u8:
                ※ past what any f64 needs, more digits change nothing
                if power < 0x10000000i64:
                    power ← power × 10i64 + ⎕widen(d, ⌜i64⌝)
                at ← at + 1
            elif separated and separator(bytes, at, from):
                at ← at + 1
            else:
                break §power
        if at = from:
            if ¬loose:
                return ⊥ ParseError.malformed
            ※ an `e` with nothing after it is not part of the number
            at ← mark
        elif down:
            exponent ← exponent - power
        else:
            exponent ← exponent + power
    let end: u64 ¤idx = at
    ※ More than nineteen digits, of which the noughts in front count for
    ※ nothing: where more than nineteen are left, `w` wrapped, and the first
    ※ nineteen are read again -- the rest, digits that cannot all be nought, say
    ※ only that the number is above what those give.
    let more: mut bool = false
    if digits > 19:
        let first: Leading = leading(bytes⟦begin…mantissa_end⟧)
        if digits - first.noughts > 19:
            w ← first.digits
            exponent ← exponent + (⎕narrow(⎕drop(digits - first.noughts), ⌜i64⌝) ?? 0i64) - 19i64
            more ← true
    if w = 0u64:
        return Parsed(.value ← ⎕from_bits(sign, ⌜f64⌝), .end ← end)
    if ¬more ∧ exponent ≥ ⁻22i64 ∧ exponent ≤ 22i64 ∧ w ≤ 9007199254740992u64:
        ※ Clinger's: both exact, so the one operation rounds once.
        let exact: f64 = ⎕float(w, ⌜f64⌝)
        let scaled: f64 = if exponent < 0i64:
            (exact ÷ EXACT_TENS⟦place(0i64 - exponent)⟧) ?? exact
        else:
            exact × EXACT_TENS⟦place(exponent)⟧
        return Parsed(.value ← ⎕from_bits(⎕bits(scaled) | sign, ⌜f64⌝), .end ← end)
    let bits: mut u64 = eisel_lemire(exponent, w)
    if more and eisel_lemire(exponent, w + 1u64) ≠ bits:
        ※ the digits left out decide, and only all of them can say how
        bits ← closest(bytes⟦begin…end⟧, bits)
    if bits ≥ INFINITY_BITS:
        return ⊥ ParseError.out_of_range
    Parsed(.value ← ⎕from_bits(bits | sign, ⌜f64⌝), .end ← end)

※ Whether the byte at `at` is a `_` between two digits -- the first of which is
※ after `from`, where the run of digits began.
fn separator(bytes: u8⟦⟧, at: u64 ¤idx, from: u64 ¤idx) → bool:
    let n: u64 ¤idx = #bytes
    bytes⟦at⟧ = 95u8 and at > from and at + 1 < n and is_digit(bytes⟦at + 1⟧)

※ The first nineteen digits of a number that count, and how many noughts came
※ before them.
type Leading = digits : u64 ; noughts : u64 ¤idx

※ What `Leading` says of the digits, points and separators of a number before
※ its exponent.
fn leading(text: u8⟦⟧) → Leading:
    let n: u64 ¤idx = #text
    let w: mut u64 = 0u64
    let kept: mut u64 = 0u64
    let noughts: mut u64 ¤idx = 0
    let at: mut u64 ¤idx = 0
    while §digits at < n and kept < 19u64:
        let d: u8 = ⎕wrap(text⟦at⟧ - 48u8)
        if d < 10u8:
            if w = 0u64 ∧ d = 0u8:
                noughts ← noughts + 1
            else:
                w ← w × 10u64 + ⎕widen(d, ⌜u64⌝)
                kept ← kept + 1u64
        at ← at + 1
    Leading(.digits ← w, .noughts ← noughts)

※ Whether a hexadecimal number's digits begin at `at`: a digit, or a point and
※ one.  `0x` and anything else is a nought followed by something else, as C
※ reads it.
fn hex_digits_at(bytes: u8⟦⟧, at: u64 ¤idx) → bool:
    let n: u64 ¤idx = #bytes
    if (digit_value(bytes⟦at⟧) ?? 255u8) < 16u8:
        return true
    bytes⟦at⟧ = 46u8 and at + 1 < n and (digit_value(bytes⟦at + 1⟧) ?? 255u8) < 16u8

※ A number known not to be negative, as the place it is in a table.
fn place(n: i64) → u64 ¤idx:
    ⎕unit(⎕narrow(n, ⌜u64⌝) ?? 0u64, ⌜idx⌝)

※ Whether the bytes at `at` are `word`, in either case: `word` is written small.
fn spelled(bytes: u8⟦⟧, at: u64 ¤idx, word: u8⟦⟧) → bool:
    let length: u64 ¤idx = #word
    if at + length > ⎕unit(⎕drop(#bytes), ⌜idx⌝):
        return false
    let i: mut u64 ¤idx = 0
    while §letters i < length:
        if (bytes⟦at + i⟧ | 32u8) ≠ word⟦i⟧:
            return false
        i ← i + 1
    true

※ An infinity or a not-a-number, spelt out after a sign.
fn special(bytes: u8⟦⟧, at: u64 ¤idx, sign: u64) → Parsed(f64) ? ParseError:
    if spelled(bytes, at, ⎕bytes("nan")):
        Parsed(.value ← ⎕from_bits(0x7FF8000000000000u64 | sign, ⌜f64⌝), .end ← at + 3)
    elif spelled(bytes, at, ⎕bytes("infinity")):
        Parsed(.value ← ⎕from_bits(INFINITY_BITS | sign, ⌜f64⌝), .end ← at + 8)
    elif spelled(bytes, at, ⎕bytes("inf")):
        Parsed(.value ← ⎕from_bits(INFINITY_BITS | sign, ⌜f64⌝), .end ← at + 3)
    else:
        ⊥ (if at = 0: ParseError.absent else: ParseError.malformed)

※ The `f64` nearest w × 10^q, w not nought, as its bits: Eisel and Lemire's, as
※ fast_float's `compute_float` has it; an infinity's bits where it is too large.
※
※ w is shifted until its top bit is set and multiplied by the upper word of the
※ power of five; where the 55 bits that matter might still be moved by a carry
※ from below -- the low nine bits of the upper half all ones -- the lower word is
※ multiplied in too.  The upper half is then the answer with one bit more than it
※ keeps, which is rounded off, and the power of two is worked out from q by a
※ multiplication that is ⌊q × log2(10)⌋ over the whole range.  A product whose
※ lower half is nought, for the powers of five that are exact, may be a tie
※ written exactly, which goes to the even one.
fn eisel_lemire(q: i64, w: u64) → u64:
    if q < ⁻342i64:
        return 0u64
    if q > 308i64:
        return INFINITY_BITS
    let lz: u8 = ⎕lead(w)
    let normal: u64 = w « ⎕widen(lz, ⌜u64⌝)
    let at: u64 ¤idx = place(2i64 × (q + 342i64))
    let first: 〈u64, u64〉 = ⎕wide_mul(normal, POWERS_OF_FIVE⟦at⟧)
    let high: mut u64 = first⟦0⟧
    let low: mut u64 = first⟦1⟧
    if high & 0x1FFu64 = 0x1FFu64:
        let second: 〈u64, u64〉 = ⎕wide_mul(normal, POWERS_OF_FIVE⟦at + 1⟧)
        low ← ⎕wrap(low + second⟦0⟧)
        if second⟦0⟧ > low:
            ※ the upper half is below w, so there is room for the carry
            high ← high + 1u64
    let upper: u8 = if high ≥ 0x8000000000000000u64: 1u8 else: 0u8
    let shift: u64 = ⎕widen(upper, ⌜u64⌝) + 9u64
    let mantissa: mut u64 = high » shift
    let power2: mut i64 = (((217706i64 × q) » 16i64) + 63i64 + ⎕widen(upper, ⌜i64⌝)
                           - ⎕widen(lz, ⌜i64⌝) + 1023i64)
    if power2 ≤ 0i64:
        ※ below the normal numbers: the bits that are not kept go, and the last
        ※ one kept is rounded on what went
        let gone: i64 = 1i64 - power2
        if gone ≥ 64i64:
            return 0u64
        mantissa ← mantissa » (⎕narrow(gone, ⌜u64⌝) ?? 0u64)
        mantissa ← mantissa + (mantissa & 1u64)
        ※ a carry into the bit in front is the smallest normal number, whose
        ※ bits these are
        return mantissa » 1u64
    if (low ≤ 1u64 ∧ q ≥ ⁻4i64 ∧ q ≤ 23i64 ∧ mantissa & 3u64 = 1u64
            ∧ mantissa « shift = high):
        ※ exactly half way, and the one below is even
        mantissa ← mantissa & ~1u64
    mantissa ← mantissa + (mantissa & 1u64)
    mantissa ← mantissa » 1u64
    if mantissa ≥ 0x0020000000000000u64:
        mantissa ← HIDDEN_BIT
        power2 ← power2 + 1i64
    if power2 ≥ 2047i64:
        return INFINITY_BITS
    ((⎕narrow(power2, ⌜u64⌝) ?? 0u64) « 52u64) | (mantissa & FRACTION_BITS)

※ A hexadecimal floating-point number, C's: digits, a point among them, and a
※ `p`, a sign and a power of two.  `start` is just after the `0x`.
※
※ The first sixteen digits that count are gathered into a `u64`, which is more
※ than the 53 bits kept and so holds where to round; whether any digit after
※ them was not nought is all the rest says.  The rounding is then on bits alone,
※ a tie to even, and a carry out of the fraction goes into the exponent by the
※ same addition -- into an infinity's, where it was the largest number.
fn hex_float(bytes: u8⟦⟧, start: u64 ¤idx, sign: u64,
             allow: Allow) → Parsed(f64) ? ParseError:
    let n: u64 ¤idx = #bytes
    let at: mut u64 ¤idx = start
    let separated: bool = allows(allow, Allow.underscores)
    let m: mut u64 = 0u64
    let kept: mut u64 = 0u64
    let exponent: mut i64 = 0i64
    let more: mut bool = false
    let digits: mut u64 = 0u64
    let point: mut bool = false
    while §digits at < n:
        let c: u8 = bytes⟦at⟧
        let d: u8 = digit_value(c) ?? 255u8
        if d < 16u8:
            if kept < 16u64:
                m ← (m « 4u64) | ⎕widen(d, ⌜u64⌝)
                if m ≠ 0u64:
                    kept ← kept + 1u64
                if point:
                    exponent ← exponent - 4i64
            else:
                if ¬point:
                    exponent ← exponent + 4i64
                more ← more ∨ d ≠ 0u8
            digits ← digits + 1u64
            at ← at + 1
        elif c = 46u8 and ¬point:
            point ← true
            at ← at + 1
        elif (separated and c = 95u8 and at > start and at + 1 < n
                and (digit_value(bytes⟦at + 1⟧) ?? 255u8) < 16u8):
            at ← at + 1
        else:
            break §digits
    if digits = 0u64:
        return ⊥ ParseError.malformed
    if (bytes⟦at - 1⟧ = 46u8 or bytes⟦start⟧ = 46u8) and ¬allows(allow, Allow.loose):
        return ⊥ ParseError.malformed
    if at < n and (bytes⟦at⟧ | 32u8) = 112u8:
        let mark: u64 ¤idx = at
        at ← at + 1
        let down: bool = at < n and bytes⟦at⟧ = 45u8
        if at < n and (down ∨ bytes⟦at⟧ = 43u8):
            at ← at + 1
        let from: u64 ¤idx = at
        let power: mut i64 = 0i64
        while §power at < n and is_digit(bytes⟦at⟧):
            if power < 0x10000000i64:
                power ← power × 10i64 + ⎕widen(⎕wrap(bytes⟦at⟧ - 48u8), ⌜i64⌝)
            at ← at + 1
        if at = from:
            if ¬allows(allow, Allow.loose):
                return ⊥ ParseError.malformed
            at ← mark
        elif down:
            exponent ← exponent - power
        else:
            exponent ← exponent + power
    if m = 0u64:
        return Parsed(.value ← ⎕from_bits(sign, ⌜f64⌝), .end ← at)
    match binary(m, exponent, more):
        u64(bits):
            Parsed(.value ← ⎕from_bits(bits | sign, ⌜f64⌝), .end ← at)
        ⊥:
            ⊥ ParseError.out_of_range

※ The bits of the `f64` nearest m × 2^e, a little more where `more` says so; m is
※ not nought.  Nothing where that is beyond the largest.
fn binary(m: u64, e: i64, more: bool) → u64?:
    let lz: u8 = ⎕lead(m)
    let top: u64 = m « ⎕widen(lz, ⌜u64⌝)
    ※ the place of the leading bit, which is the unbiased exponent
    let leading: i64 = e + 63i64 - ⎕widen(lz, ⌜i64⌝)
    if leading > 1023i64:
        return ⊥
    ※ how many of the 64 bits go: eleven for a normal number, more below them
    let gone: i64 = if leading ≥ ⁻1022i64: 11i64 else: 11i64 + (⁻1022i64 - leading)
    if gone > 64i64:
        ※ less than half the smallest number above nought
        return 0u64
    let field: u64 = if leading ≥ ⁻1022i64: ⎕narrow(leading + 1023i64, ⌜u64⌝) ?? 0u64 else: 0u64
    let drop: u64 = ⎕narrow(gone, ⌜u64⌝) ?? 0u64
    let kept: u64 = if drop = 64u64: 0u64 else: top » drop
    let rest: u64 = if drop = 64u64: top else: top - (kept « drop)
    let half: u64 = 1u64 « (drop - 1u64)
    ※ a normal number's leading bit is said by its exponent, so it comes off; the
    ※ fraction and the exponent side by side are then one number, and rounding
    ※ up is adding one to it
    let bits: u64 = (field « 52u64) + (kept & FRACTION_BITS)
    let up: bool = rest > half ∨ (rest = half ∧ (more ∨ kept & 1u64 = 1u64))
    let rounded: u64 = if up: bits + 1u64 else: bits
    if rounded ≥ INFINITY_BITS: ⊥ else: rounded

※ -- the exact comparison -----------------------------------------------------
※
※ What Eisel and Lemire cannot settle is a number of more than nineteen digits
※ whose nineteen and one more round apart.  The answer is then one of two
※ neighbours, and which is said by comparing the decimal number with the point
※ half way between them -- exactly, as two big integers.  Any number of digits may
※ be written, and 800 are all that can matter: a point half way between two
※ `f64` has at most 767 digits that count, so where the first 800 agree with it
※ only whether any digit after them is not nought decides.  The integers are then
※ at most some 2700 bits, held as 48 words, least significant first.

※ Whether a decimal number is above, at or below the point half way between the
※ `f64` whose bits are given and the one above it: 1, 0 or -1.  The bytes are the
※ number after its sign, which `parse_f64` has read and found well written:
※ digits, a point, separators, an exponent.
※
※ The `f64` is m × 2^e, so the point is (2m + 1) × 2^(e - 1); the number is
※ digits × 5^power × 2^power.  Each power whose exponent is negative is moved to
※ the other side, which leaves two whole numbers to compare: the two rows of
※ `big`, the number's and the point's.
※
※ One function and not one per operation: a big integer handed to a function and
※ answered by it is copied each way, and a frame holding the copies is larger
※ than AArch64 and RISC-V reach with an offset.  So every multiplication is the
※ one loop below, told which row, by what and what to add -- the digits nineteen
※ at a time into the number's row, and then the powers of five, twenty-seven at a
※ time, into whichever row they belong to.
fn against_half(text: u8⟦⟧, bits: u64) → i8:
    let field: u64 = bits » 52u64
    let fraction: u64 = bits & FRACTION_BITS
    let m: u64 = if field ≠ 0u64: fraction | HIDDEN_BIT else: fraction
    let e: i64 = if field ≠ 0u64: (⎕narrow(field, ⌜i64⌝) ?? 0i64) - 1075i64 else: ⁻1074i64
    let big: mut u64⟦2, 48⟧ = 〈2, 48〉 ⍴ 0u64
    let used: mut u64 ¤idx⟦2⟧ = ⟦0, 1⟧
    big⟦1, 0⟧ ← 2u64 × m + 1u64
    let n: u64 ¤idx = #text
    let at: mut u64 ¤idx = 0
    let count: mut u64 = 0u64
    let power: mut i64 = 0i64
    let more: mut bool = false
    let point: mut bool = false
    let reading: mut bool = true
    ※ once the digits are in: how many fives are left, and which row they go to
    let fives: mut u64 = 0u64
    let side: mut u64 ¤idx = 0
    while §steps true:
        let row: mut u64 ¤idx = 0
        let factor: mut u64 = 1u64
        let addend: mut u64 = 0u64
        if reading:
            ※ up to nineteen more digits that count
            let chunk: mut u64 = 0u64
            let chunked: mut u64 ¤idx = 0
            while §digits chunked < 19 and at < n:
                let c: u8 = text⟦at⟧
                if c = 46u8:
                    point ← true
                elif is_digit(c):
                    let d: u64 = ⎕widen(c - 48u8, ⌜u64⌝)
                    if count < 800u64:
                        if count > 0u64 ∨ d ≠ 0u64:
                            chunk ← chunk × 10u64 + d
                            chunked ← chunked + 1
                            count ← count + 1u64
                        if point:
                            power ← power - 1i64
                    else:
                        if ¬point:
                            power ← power + 1i64
                        more ← more ∨ d ≠ 0u64
                elif c ≠ 95u8:
                    break §digits
                at ← at + 1
            if chunked < 19:
                ※ the digits are all read: the exponent, if there is one
                reading ← false
                if at < n:
                    at ← at + 1
                    let down: bool = text⟦at⟧ = 45u8
                    if down ∨ text⟦at⟧ = 43u8:
                        at ← at + 1
                    let written: mut i64 = 0i64
                    while §exponent at < n:
                        let c: u8 = text⟦at⟧
                        if is_digit(c) ∧ written < 0x10000000i64:
                            written ← written × 10i64 + ⎕widen(c - 48u8, ⌜i64⌝)
                        at ← at + 1
                    power ← if down: power - written else: power + written
                side ← if power ≥ 0i64: 0 else: 1
                let size: i64 = if power ≥ 0i64: power else: 0i64 - power
                fives ← ⎕narrow(size, ⌜u64⌝) ?? 0u64
            if chunked = 0:
                continue §steps
            factor ← TENS⟦chunked⟧
            addend ← chunk
        elif fives ≠ 0u64:
            let step: u64 = fives ⌊ 27u64
            row ← side
            factor ← FIVES⟦⎕unit(step, ⌜idx⌝)⟧
            fives ← fives - step
        else:
            break §steps
        ※ row × factor + addend
        let carry: mut u64 = addend
        let i: mut u64 ¤idx = 0
        while §words i < used⟦row⟧:
            let product: 〈u64, u64〉 = ⎕wide_mul(big⟦row, i⟧, factor)
            let low: u64 = ⎕wrap(product⟦1⟧ + carry)
            big⟦row, i⟧ ← low
            ※ the upper half of a product is at most 2^64 - 2, so the carry fits
            carry ← product⟦0⟧ + (if low < carry: 1u64 else: 0u64)
            i ← i + 1
        if carry ≠ 0u64:
            big⟦row, i⟧ ← carry
            used⟦row⟧ ← i + 1
    ※ the powers of two, onto whichever row has the smaller: a shift in place,
    ※ from the top down, so that nothing is read after it was written
    let twos: i64 = power - (e - 1i64)
    let shifted: u64 ¤idx = if twos ≥ 0i64: 0 else: 1
    let size: i64 = if twos ≥ 0i64: twos else: 0i64 - twos
    let distance: u64 = ⎕narrow(size, ⌜u64⌝) ?? 0u64
    let words: u64 ¤idx = ⎕unit(distance » 6u64, ⌜idx⌝)
    let within: u64 = distance & 63u64
    let old: u64 ¤idx = used⟦shifted⟧
    if old ≠ 0 and distance ≠ 0u64:
        let top: u64 ¤idx = old + words + 1
        let i: mut u64 ¤idx = top
        while §down i > 0:
            i ← i - 1
            ※ the word that lands here, and the bits of the one below it that
            ※ come up into it
            let high: u64 = if i ≥ words and i - words < old: big⟦shifted, i - words⟧ else: 0u64
            let low: u64 = if i ≥ words + 1 and i - words - 1 < old: big⟦shifted, i - words - 1⟧ else: 0u64
            big⟦shifted, i⟧ ← if within = 0u64: high else: (high « within) | (low » (64u64 - within))
        used⟦shifted⟧ ← if big⟦shifted, top - 1⟧ = 0u64: top - 1 else: top
    ※ which is larger, from the top word down
    if used⟦0⟧ ≠ used⟦1⟧:
        return if used⟦0⟧ < used⟦1⟧: ⁻1i8 else: 1i8
    let i: mut u64 ¤idx = used⟦0⟧
    while §compare i > 0:
        i ← i - 1
        if big⟦0, i⟧ ≠ big⟦1, i⟧:
            return if big⟦0, i⟧ < big⟦1, i⟧: ⁻1i8 else: 1i8
    ※ digits beyond the 800 put the number above where they stopped, and the
    ※ point half way has none there
    if more: 1i8 else: 0i8

※ The bits of the `f64` nearest the decimal number `text` writes, from a guess
※ that is at most a step or two away from them.
※
※ Up while the number is past the point half way to the next one, or at it with
※ the guess odd; down while it is short of the point half way to the one below,
※ or at it with the guess odd.  A step up from the largest is an infinity, which
※ the caller says is out of range.
fn closest(text: u8⟦⟧, guess: u64) → u64:
    let bits: mut u64 = guess
    while §up bits < INFINITY_BITS:
        let order: i8 = against_half(text, bits)
        if order > 0i8 ∨ (order = 0i8 ∧ bits & 1u64 = 1u64):
            bits ← bits + 1u64
        else:
            break §up
    if bits ≥ INFINITY_BITS:
        return bits
    while §down bits > 0u64:
        let order: i8 = against_half(text, bits - 1u64)
        if order < 0i8 ∨ (order = 0i8 ∧ bits & 1u64 = 1u64):
            bits ← bits - 1u64
        else:
            break §down
    bits

※ -- writing numbers ----------------------------------------------------------
※
※ Digits are written into a buffer of the frame, from the right, and joined onto
※ the list in one move.  `format_int` writes them there itself: a function
※ writing a buffer it was handed is not pure, and one answering a buffer of
※ digits copies it into its caller's room, which for a whole number costs a
※ fifth again of what the digits do.  `numeral_int` and `numeral_f64` answer
※ the buffer, as a `Numeral`, for a writer whose list is an arena's -- which a
※ list handed in and back is not moved through, an arena's being answered as a
※ copy in the heap -- and `format_f64` is `numeral_f64` joined on, its layout
※ being too long to write twice and its digits dearer than the copy.

※ v ÷ 10, as a multiplication by its inverse and a shift, which is what C
※ compilers make of a division by a constant: this one asks the machine to
※ divide, which costs some thirty times as much.  The inverse is ⌈2^67 ÷ 10⌉,
※ which is exact for every u64.
fn tenth(v: u64) → u64:
    let product: 〈u64, u64〉 = ⎕wide_mul(v, 0xCCCCCCCCCCCCCCCDu64)
    product⟦0⟧ » 3u64

※ How many decimal digits v has, v not nought: ⌊log10(2) × the bits it has⌋,
※ which is right or one short, and a comparison with a power of ten to say which.
fn decimal_count(v: u64) → u64 ¤idx:
    let bits: u64 = 64u64 - ⎕widen(⎕lead(v), ⌜u64⌝)
    let t: u64 ¤idx = ⎕unit((bits × 1233u64) » 12u64, ⌜idx⌝)
    if v ≥ TENS⟦t⟧: t + 1 else: t

※※ A number written out, as a value: the bytes `text⟦from…to⟧`.
※※
※※ \details What `format_int` and `format_f64` join onto a list, answered rather
※※ than joined: a writer whose list is an arena's, or that wants the text in a
※※ buffer of its own, takes the bytes from here.  Seventy-two bytes are room for
※※ a sign and the sixty-four digits of a `u64` in base two.
@[export]
type Numeral = text : u8⟦72⟧ ; from : u64 ¤idx ; to : u64 ¤idx

※※ A whole number written out, as `format_int` writes it.
※※
※※ \param n the number, of any whole-number type
※※ \param base how many digits a place has
※※ \param digits how many digits at least
※※ \param upper whether the digits past nine are capitals
※※ \return the text, at the end of the room: from `from` to seventy-two
※
※ The magnitude is a `u64` whatever the type, so one body writes them all, and a
※ sign is a flag beside it: the smallest `i64` has a magnitude and no positive.
※ Base ten goes two digits at a time; the others one, by division.  The digits
※ are written from the right, and the noughts in front of them are the room's.
@[export]
fn numeral_int(n: T', base: u8 ← 10u8, digits: u8 ← 1u8, upper: bool ← false) → Numeral
        pre(base ≥ 2u8 ∧ base ≤ 36u8):
    let magnitude: mut u64 = 0u64
    let negative: mut bool = false
    comptime if ⌜T'⌝ = ⌜u64⌝:
        magnitude ← n
    else:
        ※ every other whole number fits an i64
        let signed: i64 = ⎕narrow(n, ⌜i64⌝) ?? 0i64
        negative ← signed < 0i64
        if negative:
            magnitude ← (⎕narrow(⁻1i64 - signed, ⌜u64⌝) ?? 0u64) + 1u64
        else:
            magnitude ← ⎕narrow(signed, ⌜u64⌝) ?? 0u64
    let text: mut u8⟦72⟧ = 72 ⍴ 48u8
    let at: mut u64 ¤idx = 72
    let rest: mut u64 = magnitude
    if base = 10u8:
        ※ two digits a step, ÷ 100 being v ÷ 4 times ⌈2^68 ÷ 25⌉, exact for every u64
        while §pairs rest ≥ 100u64:
            let product: 〈u64, u64〉 = ⎕wide_mul(rest » 2u64, 0x28F5C28F5C28F5C3u64)
            let below: u64 = product⟦0⟧ » 2u64
            let pair: u64 ¤idx = ⎕unit(2u64 × (rest - below × 100u64), ⌜idx⌝)
            at ← at - 2
            text⟦at⟧ ← PAIRS⟦pair⟧
            text⟦at + 1⟧ ← PAIRS⟦pair + 1⟧
            rest ← below
        if rest ≥ 10u64:
            let pair: u64 ¤idx = ⎕unit(2u64 × rest, ⌜idx⌝)
            at ← at - 2
            text⟦at⟧ ← PAIRS⟦pair⟧
            text⟦at + 1⟧ ← PAIRS⟦pair + 1⟧
        else:
            at ← at - 1
            text⟦at⟧ ← byte_of(rest + 48u64)
    else:
        let radix: u64 = ⎕widen(base, ⌜u64⌝)
        let past: u64 = if upper: 55u64 else: 87u64
        let more: mut bool = true
        while §places more:
            let below: u64 = rest ÷ radix ?? 0u64
            let d: u64 = rest - below × radix
            at ← at - 1
            text⟦at⟧ ← byte_of(d + (if d < 10u64: 48u64 else: past))
            rest ← below
            more ← rest ≠ 0u64
    let wanted: u64 ¤idx = ⎕unit(⎕widen(digits ⌊ 64u8, ⌜u64⌝), ⌜idx⌝)
    if 72 - at < wanted:
        ※ the noughts are already there: the room was made of them
        at ← 72 - wanted
    if negative:
        at ← at - 1
        text⟦at⟧ ← 45u8
    Numeral(.text ← text, .from ← at, .to ← 72)

※※ A whole number written onto the end of some bytes.
※※
※※ \details A `-` in front of a negative one -- the ASCII hyphen-minus that JSON and
※※ every other data format writes, where `std.text` writes the raised minus a
※※ literal of this language is written with -- and then the digits of *base*, the
※※ ones past nine letters, small or, with *upper*, capital.  At least *digits* of
※※ them, noughts in front where there are fewer, which is how four hexadecimal
※※ digits of a `\u` escape are written: `format_int(c, out, .base ← 16u8,
※※ .digits ← 4u8)`.  No prefix says the base.
※※
※※ \param n the number, of any whole-number type
※※ \param into what to write onto
※※ \param base how many digits a place has
※※ \param digits how many digits at least
※※ \param upper whether the digits past nine are capitals
※※ \return what was handed in, the text after what it held
※
※ The magnitude is a `u64` whatever the type, so one body writes them all, and a
※ sign is a flag beside it: the smallest `i64` has a magnitude and no positive.
※ Base ten goes two digits at a time; the others one, by division.
@[export]
fn format_int(n: T', into: mut [u8], base: u8 ← 10u8, digits: u8 ← 1u8,
              upper: bool ← false) → [u8]
        pre(base ≥ 2u8 ∧ base ≤ 36u8):
    let magnitude: mut u64 = 0u64
    let negative: mut bool = false
    comptime if ⌜T'⌝ = ⌜u64⌝:
        magnitude ← n
    else:
        ※ every other whole number fits an i64
        let signed: i64 = ⎕narrow(n, ⌜i64⌝) ?? 0i64
        negative ← signed < 0i64
        if negative:
            magnitude ← (⎕narrow(⁻1i64 - signed, ⌜u64⌝) ?? 0u64) + 1u64
        else:
            magnitude ← ⎕narrow(signed, ⌜u64⌝) ?? 0u64
    if negative:
        into ⧺← ⟦45u8⟧
    let text: mut u8⟦24⟧ = 24 ⍴ 48u8
    let at: mut u64 ¤idx = 24
    let rest: mut u64 = magnitude
    if base = 10u8:
        ※ two digits a step, ÷ 100 being v ÷ 4 times ⌈2^68 ÷ 25⌉, exact for every u64
        while §pairs rest ≥ 100u64:
            let product: 〈u64, u64〉 = ⎕wide_mul(rest » 2u64, 0x28F5C28F5C28F5C3u64)
            let below: u64 = product⟦0⟧ » 2u64
            let pair: u64 ¤idx = ⎕unit(2u64 × (rest - below × 100u64), ⌜idx⌝)
            at ← at - 2
            text⟦at⟧ ← PAIRS⟦pair⟧
            text⟦at + 1⟧ ← PAIRS⟦pair + 1⟧
            rest ← below
        if rest ≥ 10u64:
            let pair: u64 ¤idx = ⎕unit(2u64 × rest, ⌜idx⌝)
            at ← at - 2
            text⟦at⟧ ← PAIRS⟦pair⟧
            text⟦at + 1⟧ ← PAIRS⟦pair + 1⟧
        else:
            at ← at - 1
            text⟦at⟧ ← byte_of(rest + 48u64)
    else:
        let radix: u64 = ⎕widen(base, ⌜u64⌝)
        let past: u64 = if upper: 55u64 else: 87u64
        let more: mut bool = true
        while §places more:
            let below: u64 = rest ÷ radix ?? 0u64
            let d: u64 = rest - below × radix
            at ← at - 1
            text⟦at⟧ ← byte_of(d + (if d < 10u64: 48u64 else: past))
            rest ← below
            more ← rest ≠ 0u64
    let wanted: u64 ¤idx = ⎕unit(⎕widen(digits ⌊ 24u8, ⌜u64⌝), ⌜idx⌝)
    if 24 - at < wanted:
        ※ the noughts are already there: the buffer was made of them
        at ← 24 - wanted
    into ⧺← text⟦at…24⟧
    into

※ The low byte of a number known to fit one.
fn byte_of(n: u64) → u8:
    ⎕narrow(n, ⌜u8⌝) ?? 0u8

※※ Which of two ways `format_f64` lays out the digits of a number.
※※
※※ \details `javascript` is `Number.prototype.toString`'s, which `JSON.stringify`
※※ writes: no point where the number is whole, up to twenty-one digits before an
※※ exponent is used and six noughts after the point -- `100`, `1e+21`, `1e-7`.
※※ `python` is `repr`'s, which Python's `json` writes: a point or an exponent
※※ always, so that what is read back is not taken for a whole number, the
※※ exponent from 10¹⁶ on and below 10⁻⁴, and two digits of it at least --
※※ `100.0`, `1e+16`, `1e-05`, `0.0001`.
@[export]
enum Form:
    javascript ;
    python

※※ The shortest text that reads back as the same `f64`, as `format_f64` writes it.
※※
※※ \param x the number
※※ \param form how the digits are laid out
※※ \return the text
※
※ The digits are Giulietti's Schubfach, which was chosen over Ryu and Dragonbox
※ for what it costs to write and to trust: one table of 617 powers of ten where
※ Ryu has two, three products of a 64-bit number by a 128-bit one and a handful of
※ comparisons where Dragonbox has many cases and a proof for each, and the same
※ digits as both.  The three products are the number and its two neighbours'
※ half-way points scaled by the power of ten that leaves a whole number with one
※ or two digits to spare, each rounded to odd so that whether it was exact is
※ kept in its last bit; the digits are then the shortest whole number inside the
※ interval, one digit fewer tried first.  Trailing noughts are taken off, and the
※ digits are laid out in the numeral's room, which `format_f64` joins on in one
※ move.
@[export]
fn numeral_f64(x: f64, form: Form ← Form.javascript) → Numeral:
    let python: bool = form = Form.python
    let bits: u64 = ⎕bits(x)
    let negative: bool = bits ≥ 0x8000000000000000u64
    let magnitude: u64 = bits & 0x7FFFFFFFFFFFFFFFu64
    let out: mut u8⟦72⟧ = 72 ⍴ 48u8
    if magnitude ≥ INFINITY_BITS:
        if magnitude > INFINITY_BITS:
            out⟦0…3⟧ ← ⎕bytes("NaN")
            return Numeral(.text ← out, .from ← 0, .to ← 3)
        if negative:
            out⟦0…9⟧ ← ⎕bytes("-Infinity")
            return Numeral(.text ← out, .from ← 0, .to ← 9)
        out⟦0…8⟧ ← ⎕bytes("Infinity")
        return Numeral(.text ← out, .from ← 0, .to ← 8)
    if magnitude = 0u64:
        ※ the noughts are the room's own
        out⟦0⟧ ← 45u8
        out⟦2⟧ ← 46u8
        return Numeral(.text ← out, .from ← if negative: 0 else: 1, .to ← if python: 4 else: 2)
    let decimal: 〈u64, i64〉 = shortest(magnitude)
    let value: mut u64 = decimal⟦0⟧
    let power: mut i64 = decimal⟦1⟧
    while §noughts value ≥ 10u64:
        let below: u64 = tenth(value)
        if below × 10u64 ≠ value:
            break §noughts
        value ← below
        power ← power + 1i64
    let k: u64 ¤idx = decimal_count(value)
    let count: i64 = ⎕narrow(⎕drop(k), ⌜i64⌝) ?? 0i64
    ※ where the point goes, counted from in front of the first digit
    let point: i64 = count + power
    let start: u64 ¤idx = if negative: 1 else: 0
    out⟦0⟧ ← if negative: 45u8 else: 48u8
    ※ JavaScript's four forms, each saying where the digits go -- they end just
    ※ before `stop` -- and how long the text is.  The noughts, before the digits
    ※ or after them, are the buffer's own.  Python's are the same four, the first
    ※ two ending sooner.
    let widest: i64 = if python: 16i64 else: 21i64
    let integer: bool = count ≤ point ∧ point ≤ widest
    let inside: bool = ¬integer ∧ 0i64 < point ∧ point ≤ widest
    let small: bool = (if python: ⁻4i64 else: ⁻6i64) < point ∧ point ≤ 0i64
    let stop: u64 ¤idx = if integer:
        start + k
    elif small:
        start + 2 + place(0i64 - point) + k
    else:
        ※ one place to the right, to make room for the point after it is done
        start + 1 + k
    let at: mut u64 ¤idx = stop
    let rest: mut u64 = value
    while §pairs rest ≥ 100u64:
        let product: 〈u64, u64〉 = ⎕wide_mul(rest » 2u64, 0x28F5C28F5C28F5C3u64)
        let below: u64 = product⟦0⟧ » 2u64
        let pair: u64 ¤idx = ⎕unit(2u64 × (rest - below × 100u64), ⌜idx⌝)
        at ← at - 2
        out⟦at⟧ ← PAIRS⟦pair⟧
        out⟦at + 1⟧ ← PAIRS⟦pair + 1⟧
        rest ← below
    if rest ≥ 10u64:
        let pair: u64 ¤idx = ⎕unit(2u64 × rest, ⌜idx⌝)
        out⟦at - 2⟧ ← PAIRS⟦pair⟧
        out⟦at - 1⟧ ← PAIRS⟦pair + 1⟧
    else:
        out⟦at - 1⟧ ← byte_of(rest + 48u64)
    let length: mut u64 ¤idx = stop
    if integer:
        length ← start + place(point)
        if python:
            ※ the nought after the point is the buffer's
            out⟦length⟧ ← 46u8
            length ← length + 2
    elif inside:
        ※ the digits before the point move back into the place left for them
        let whole: u64 ¤idx = place(point)
        out⟦start…start + whole⟧ ← out⟦start + 1…start + 1 + whole⟧
        out⟦start + whole⟧ ← 46u8
    elif small:
        out⟦start + 1⟧ ← 46u8
    else:
        out⟦start⟧ ← out⟦start + 1⟧
        if k > 1:
            out⟦start + 1⟧ ← 46u8
        else:
            length ← start + 1
        let e: i64 = point - 1i64
        out⟦length⟧ ← 101u8
        out⟦length + 1⟧ ← if e < 0i64: 45u8 else: 43u8
        let away: i64 = if e < 0i64: 0i64 - e else: e
        let size: u64 = ⎕narrow(away, ⌜u64⌝) ?? 0u64
        ※ one digit to three: e+308 at the most, e-324 at the least
        if size ≥ 100u64:
            let hundreds: u64 = tenth(tenth(size))
            out⟦length + 2⟧ ← byte_of(hundreds + 48u64)
            let pair: u64 ¤idx = ⎕unit(2u64 × (size - hundreds × 100u64), ⌜idx⌝)
            out⟦length + 3⟧ ← PAIRS⟦pair⟧
            out⟦length + 4⟧ ← PAIRS⟦pair + 1⟧
            length ← length + 5
        elif size ≥ 10u64:
            let pair: u64 ¤idx = ⎕unit(2u64 × size, ⌜idx⌝)
            out⟦length + 2⟧ ← PAIRS⟦pair⟧
            out⟦length + 3⟧ ← PAIRS⟦pair + 1⟧
            length ← length + 4
        elif python:
            ※ the nought in front of the digit is the buffer's
            out⟦length + 3⟧ ← byte_of(size + 48u64)
            length ← length + 4
        else:
            out⟦length + 2⟧ ← byte_of(size + 48u64)
            length ← length + 3
    Numeral(.text ← out, .from ← 0, .to ← length)

※※ The shortest text that reads back as the same `f64`, written onto the end of
※※ some bytes.
※※
※※ \details In the form JavaScript's `Number.prototype.toString` gives it --
※※ which is what `JSON.stringify` writes -- or with *form* the form Python's
※※ `repr` gives it.  The digits are the fewest that `parse_f64` reads back as this number,
※※ and of several so few the nearest to it, a tie to the even digit.  Where they
※※ go is JavaScript's rule.  With the digits d₁…dₖ and the number d₁.d₂…dₖ ×
※※ 10ⁿ⁻¹:
※※
※※ - k ≤ n ≤ 21: the digits and n - k noughts, no point -- `100`, `1e21` being
※※   `1000000000000000000000`;
※※ - 0 < n ≤ 21: the digits with a point after the first n -- `1.5`, `123.456`;
※※ - -6 < n ≤ 0: `0.`, -n noughts and the digits -- `0.000001`;
※※ - otherwise one digit, a point and the rest where there are more, `e`, a sign
※※   and n - 1 -- `1e+21`, `1.5e-7`, `5e-324`.
※※
※※ Python's rule is the same with 16 for 21 and -4 for -6, `.0` after a whole
※※ number, `0.0` for nought and at least two digits of exponent: `1e-07`.
※※
※※ A negative number has a `-` in front.  The one place this parts from
※※ JavaScript is nought with its sign, which this writes `-0` and JavaScript
※※ `0`: what is written here reads back as the number it was.  A number
※※ that is not finite, which JSON has no way to write, is what JavaScript calls it
※※ -- `Infinity`, `-Infinity`, `NaN` -- and what `parse_f64` reads back with
※※ `Allow.special`.
※※
※※ \param x the number
※※ \param into what to write onto
※※ \param form how the digits are laid out
※※ \return what was handed in, the text after what it held
@[export]
fn format_f64(x: f64, into: mut [u8], form: Form ← Form.javascript) → [u8]:
    let written: Numeral = numeral_f64(x, form)
    into ⧺← written.text⟦written.from…written.to⟧
    into

※ The digits and the power of ten of the shortest decimal number that reads
※ back as the positive, finite `f64` whose bits are given: Schubfach, as
※ Giulietti wrote it, ⌊log10⌋ and ⌊log2⌋ of powers worked out by multiplication.
fn shortest(bits: u64) → 〈u64, i64〉:
    let field: u64 = bits » 52u64
    let fraction: u64 = bits & FRACTION_BITS
    let c: u64 = if field ≠ 0u64: fraction | HIDDEN_BIT else: fraction
    let q: i64 = if field ≠ 0u64: (⎕narrow(field, ⌜i64⌝) ?? 0i64) - 1075i64 else: ⁻1074i64
    let even: bool = c & 1u64 = 0u64
    ※ the neighbour below is nearer where the fraction is nought, the exponent
    ※ above it being one the number below does not share
    let closer: bool = fraction = 0u64 ∧ field > 1u64
    let cbl: u64 = 4u64 × c - 2u64 + (if closer: 1u64 else: 0u64)
    let cb: u64 = 4u64 × c
    let cbr: u64 = 4u64 × c + 2u64
    ※ ⌊log10(2^q)⌋, or of three quarters of it where the lower neighbour is nearer
    let k: i64 = (q × 1262611i64 - (if closer: 524031i64 else: 0i64)) » 22i64
    let h: u64 = ⎕narrow(q + (((0i64 - k) × 1741647i64) » 19i64) + 1i64, ⌜u64⌝) ?? 0u64
    let at: u64 ¤idx = place(2i64 × (292i64 - k))
    let upper: u64 = POWERS_OF_TEN⟦at⟧
    let lower: u64 = POWERS_OF_TEN⟦at + 1⟧
    let vbl: u64 = to_odd(upper, lower, cbl « h)
    let vb: u64 = to_odd(upper, lower, cb « h)
    let vbr: u64 = to_odd(upper, lower, cbr « h)
    ※ the interval's ends are in it where the number is even
    let low: u64 = vbl + (if even: 0u64 else: 1u64)
    let high: u64 = vbr - (if even: 0u64 else: 1u64)
    let s: u64 = vb » 2u64
    if s ≥ 10u64:
        ※ one digit fewer: at most one of the two around it is inside
        let sp: u64 = tenth(s)
        let below_in: bool = low ≤ 40u64 × sp
        let above_in: bool = 40u64 × sp + 40u64 ≤ high
        if below_in ≠ above_in:
            return 〈sp + (if above_in: 1u64 else: 0u64), k + 1i64〉
    let below_in: bool = low ≤ 4u64 × s
    let above_in: bool = 4u64 × s + 4u64 ≤ high
    if below_in ≠ above_in:
        return 〈s + (if above_in: 1u64 else: 0u64), k〉
    ※ both, or neither: the nearer of the two, a tie to the even one
    let middle: u64 = 4u64 × s + 2u64
    let up: bool = vb > middle ∨ (vb = middle ∧ s & 1u64 = 1u64)
    〈s + (if up: 1u64 else: 0u64), k〉

※ The upper 64 bits of g × cp, g being the 128 bits of `upper` and `lower`, with
※ the last of them set where anything below them was not nought.
fn to_odd(upper: u64, lower: u64, cp: u64) → u64:
    let x: 〈u64, u64〉 = ⎕wide_mul(lower, cp)
    let y: 〈u64, u64〉 = ⎕wide_mul(upper, cp)
    let middle: u64 = ⎕wrap(y⟦1⟧ + x⟦0⟧)
    let top: u64 = y⟦0⟧ + (if middle < x⟦0⟧: 1u64 else: 0u64)
    top | (if middle > 1u64: 1u64 else: 0u64)

※ -- characters ---------------------------------------------------------------

※※ A character written onto the end of some bytes, as UTF-8.
※※
※※ \param c the character
※※ \param into what to write onto
※※ \return what was handed in, with the one to four bytes of `c` after what it held
@[export]
fn format_char(c: char, into: mut [u8]) → [u8]:
    let n: u32 = ⎕ord(c)
    if n < 0x80u32:
        into ⧺← ⟦byte(n)⟧
    elif n < 0x800u32:
        into ⧺← ⟦byte(0xC0u32 | (n » 6u32)), byte(0x80u32 | (n & 0x3Fu32))⟧
    elif n < 0x10000u32:
        into ⧺← ⟦byte(0xE0u32 | (n » 12u32)), byte(0x80u32 | ((n » 6u32) & 0x3Fu32)),
                 byte(0x80u32 | (n & 0x3Fu32))⟧
    else:
        into ⧺← ⟦byte(0xF0u32 | (n » 18u32)), byte(0x80u32 | ((n » 12u32) & 0x3Fu32)),
                 byte(0x80u32 | ((n » 6u32) & 0x3Fu32)), byte(0x80u32 | (n & 0x3Fu32))⟧
    into

※ The low byte of a code point's bits, which are known to fit one.
fn byte(n: u32) → u8:
    ⎕narrow(n, ⌜u8⌝) ?? 0u8

※※ The character one UTF-8 sequence at the start of some bytes encodes.
※※
※※ \details Well formed is Unicode's Table 3-7, as `⎕text` reads it: no overlong
※※ form, no surrogate, nothing above U+10FFFF, no continuation byte without a
※※ leading one and no leading byte without all of its continuation bytes.  What
※※ a decoder of JSON's strings wants a character at a time, where `⎕text` checks
※※ a whole run of them and makes a `str`.
※※
※※ \param bytes what to read, from its first byte
※※ \return the character, and how many bytes it took: one to four
※※ \raises `absent` where there are no bytes, and `malformed` where they do not
※※ begin with a well-formed sequence
@[export]
fn decode_char(bytes: u8⟦⟧) → Parsed(char) ? ParseError:
    let n: u64 ¤idx = #bytes
    if n = 0:
        return ⊥ ParseError.absent
    let lead: u8 = bytes⟦0⟧
    if lead < 0x80u8:
        return Parsed(.value ← ⎕chr(⎕widen(lead, ⌜u32⌝)), .end ← 1)
    ※ how many bytes, and what the first continuation byte may be: E0 and F0 ask
    ※ more of it, so that nothing has an overlong form, ED less, so that nothing is
    ※ a surrogate, and F4 less, so that nothing is above U+10FFFF
    let length: u64 ¤idx = if lead < 0xC2u8:
        0
    elif lead < 0xE0u8:
        2
    elif lead < 0xF0u8:
        3
    elif lead < 0xF5u8:
        4
    else:
        0
    if length = 0 or length > n:
        return ⊥ ParseError.malformed
    let lowest: u8 = if lead = 0xE0u8: 0xA0u8 elif lead = 0xF0u8: 0x90u8 else: 0x80u8
    let highest: u8 = if lead = 0xEDu8: 0x9Fu8 elif lead = 0xF4u8: 0x8Fu8 else: 0xBFu8
    let second: u8 = bytes⟦1⟧
    if second < lowest ∨ second > highest:
        return ⊥ ParseError.malformed
    ※ the bits of the leading byte below the ones that say how many follow
    let mask: u8 = if length = 2: 0x1Fu8 elif length = 3: 0x0Fu8 else: 0x07u8
    let code: mut u32 = ⎕widen(lead & mask, ⌜u32⌝)
    code ← (code « 6u32) | ⎕widen(second & 0x3Fu8, ⌜u32⌝)
    let i: mut u64 ¤idx = 2
    while §continued i < length:
        let more: u8 = bytes⟦i⟧
        if more & 0xC0u8 ≠ 0x80u8:
            return ⊥ ParseError.malformed
        code ← (code « 6u32) | ⎕widen(more & 0x3Fu8, ⌜u32⌝)
        i ← i + 1
    Parsed(.value ← ⎕chr(code), .end ← length)
