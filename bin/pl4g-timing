#: How many times each sample is compiled.  The best is kept.
RUNS = 5


def sample_path(name: str) -> Path:
    """Where the program called *name* lives."""
    return ROOT / "tests" / "language" / name / "".join((name, ".pl4g"))


def commit() -> str:
    """The short hash of the commit being measured, marked if the tree is dirty."""
    short = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
                           capture_output=True, text=True, check=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", str(ROOT), "status", "--porcelain",
                            "--untracked-files=no"],
                           capture_output=True, text=True, check=True).stdout.strip()
    return "".join((short, "+" if dirty else ""))


def subject(rev: str = "HEAD") -> str:
    """The first line of the commit message, to say what a column is.

    Signature verification is turned off for this call: where the repository is
    configured to show it, it lands in the output and would become the subject.
    """
    return subprocess.run(["git", "-C", str(ROOT), "log", "-1",
                           "--no-show-signature", "--format=%s", rev],
                          capture_output=True, text=True, check=True).stdout.strip()


def work_of(stderr: str) -> float:
    """The sum of the stage timings the compiler reported."""
    total = 0.0
    for line in stderr.splitlines():
        parts = line.split(" ms  ", 1)
        if len(parts) == 2:
            try:
                total += float(parts[0])
            except ValueError:
                continue
    return total


def measure(name: str, triple: str, output: Path) -> tuple[float, float] | None:
    """The best work and process times of compiling *name*, in milliseconds."""
    source = sample_path(name)
    if not source.exists():
        return None
    command = [sys.executable, "-m", "pypl4g", "--time-report", "-o", str(output),
               "".join(("--target=", triple)), str(source)]
    best_work: float | None = None
    best_process: float | None = None
    for _ in range(RUNS):
        start = time.perf_counter()
        proc = subprocess.run(command, capture_output=True, text=True, cwd=ROOT)
        elapsed = (time.perf_counter() - start) * 1000
        if proc.returncode != 0:
            return None
        work = work_of(proc.stderr)
        best_work = work if best_work is None else min(best_work, work)
        best_process = elapsed if best_process is None else min(best_process, elapsed)
    assert best_work is not None and best_process is not None
    return best_work, best_process


def load() -> dict[str, object]:
    """The figures recorded so far."""
    if not DATA.exists():
        return {"samples": {}, "commits": [], "times": {}}
    return json.loads(DATA.read_text(encoding="utf-8"))


def _cell(times: dict[str, dict[str, list[float]]], head: str, name: str,
          column: int, digits: int) -> str:
    """One figure, or nothing where the sample did not exist at that commit."""
    found = times.get(head, {}).get(name)
    if found is None:
        return ""
    return format(found[column], "".join((".", str(digits), "f")))


#: The widest a table is allowed to be, counting the column that names the
#: commit.  A group that has gathered more samples than that is written as
#: several tables rather than as one that has to be scrolled sideways to read:
#: a column nobody can see beside the commit it belongs to is a column nobody
#: can read.  Samples are never removed, so every group reaches this eventually.
WIDEST: Final[int] = 15


def _group_table(group: Group, heads: list[str],
                 times: dict[str, dict[str, list[float]]]) -> list[str]:
    """One group's table: a commit per row, a program per column.

    Several tables where the group has more programs than one table may hold.
    They are numbered where there is more than one, so that a reader who has
    found a figure can say which table it was in.
    """
    names = [n for n in group.samples if any(n in times.get(h, {}) for h in heads)]
    if not names:
        return []
    parts = [names[at:at + WIDEST - 1] for at in range(0, len(names), WIDEST - 1)]
    lines: list[str] = []
    for number, part in enumerate(parts, start=1):
        title = (group.title if len(parts) == 1
                 else "".join((group.title, " (", str(number), " of ",
                               str(len(parts)), ")")))
        lines.extend(("".join(("### ", title)), ""))
        if number == 1:
            lines.extend((*textwrap.wrap(group.note, width=110), ""))
        lines.extend((
            "".join(("| commit | ", " | ".join(part), " |")),
            "".join(("|---|", "---|" * len(part)))))
        for head in heads:
            row = ["".join(("`", head, "`"))]
            row.extend(_cell(times, head, name, 0, 2) for name in part)
            lines.append("".join(("| ", " | ".join(row), " |")))
        lines.append("")
    return lines


def _process_table(heads: list[str], samples: dict[str, str],
                   times: dict[str, dict[str, list[float]]]) -> list[str]:
    """The whole run, as one table rather than one per group.

    It is dominated by starting the interpreter and importing the package, so
    the differences between one sample and the next are noise and only the range
    is worth showing.  Every figure is in the JSON beside this file.
    """
    lines = ["| commit | fastest | slowest |", "|---|---|---|"]
    for head in heads:
        found = [v[1] for n, v in times.get(head, {}).items() if n in samples]
        if not found:
            continue
        lines.append("".join(("| `", head, "` | ", format(min(found), ".0f"),
                              " | ", format(max(found), ".0f"), " |")))
    lines.append("")
    return lines


def render(data: dict[str, object]) -> str:
    """The tables, as Markdown."""
    commits = list(data["commits"])  # type: ignore[arg-type]
    times: dict[str, dict[str, list[float]]] = data["times"]  # type: ignore[assignment]
    samples: dict[str, str] = data["samples"]  # type: ignore[assignment]
    heads = [c["hash"] for c in commits]  # type: ignore[index]
    grouped = {n for g in GROUPS for n in g.samples}
    leftover = Group("Ungrouped",
                     "Measured before the groups above were drawn, and kept "
                     "because a figure once taken is not thrown away.",
                     {n: samples.get(n, "") for n in samples if n not in grouped})
    lines = [
        "Compiler Timings",
        "================",
        "",
        "How long the compiler takes on each sample program, in milliseconds, the",
        "best of five runs.  One row per commit and one column per program: the",
        "commits go on for ever, so the tables grow down rather than across, and",
        "the programs are split into groups by what would move them.  A blank",
        "means the sample did not exist yet at that commit.",
        "",
        "A table is at most fifteen columns wide, counting the one that names the",
        "commit; a group with more programs than that is written as several,",
        "numbered.  Samples are never removed, so every group reaches that width",
        "in the end -- and a column nobody can see beside the commit it belongs to",
        "is a column nobody can read.",
        "",
        "Measured on one machine, so the numbers are worth comparing with each",
        "other and with nobody else's.  A hash ending in `+` was measured with",
        "changes not yet committed.  Written by `bin/pl4g-timing`.",
        "",
        "Work",
        "----",
        "",
        "The sum of the compiler's own stages, which is what a change to the",
        "compiler moves.",
        "",
    ]
    for group in (*GROUPS, leftover):
        lines += _group_table(group, heads, times)
    lines += ["Process", "-------", "",
              "The whole run, which is what someone waiting for the compiler waits",
              "for.  For the bootstrap compiler this is mostly starting the",
              "interpreter and importing the package, so what one sample costs and",
              "what the next costs is noise; only the range across all of them is",
              "worth showing here, and every figure is in the JSON beside this file.",
              ""]
    lines += _process_table(heads, samples, times)
    lines.append("What each row is:")
    lines.append("")
    for entry in commits:
        lines.append("".join(("- `", entry["hash"], "` -- ",  # type: ignore[index]
                              entry["subject"])))  # type: ignore[index]
    lines.append("")
    lines.append("What each program exercises:")
    lines.append("")
    for group in (*GROUPS, leftover):
        for name, why in group.samples.items():
            if name in samples:
                lines.append("".join(("- `", name, "` -- ", why)))
    return "\n".join(lines) + "\n"


def main() -> int:
    """Measure and record."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", default="x86_64-linux-none",
                        help="the triple to compile for")
    parser.add_argument("--dry-run", action="store_true",
                        help="measure and print, without recording")
    args = parser.parse_args()

    data = load()
    samples: dict[str, str] = data["samples"]  # type: ignore[assignment]
    for group in GROUPS:
        for name, why in group.samples.items():
            samples.setdefault(name, why)

    head = commit()
    measured: dict[str, list[float]] = {}
    import tempfile
    with tempfile.TemporaryDirectory() as directory:
        output = Path(directory) / "out"
        for name in samples:
            found = measure(name, args.target, output)
            if found is None:
                print("".join(("       -        -  ", name)), file=sys.stderr)
                continue
            measured[name] = [found[0], found[1]]
            print("".join((format(found[0], "8.2f"), " ms work  ",
                           format(found[1], "6.0f"), " ms total  ", name)),
                  file=sys.stderr)

    if args.dry_run:
        return 0

    commits: list[dict[str, str]] = data["commits"]  # type: ignore[assignment]
    times: dict[str, dict[str, list[float]]] = data["times"]  # type: ignore[assignment]
    commits[:] = [c for c in commits if c["hash"] != head]
    commits.append({"hash": head, "subject": subject()})
    times[head] = measured
    DATA.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n",
                    encoding="utf-8")
    TABLE.write_text(render(data), encoding="utf-8")
    print("".join(("recorded ", head, " in ", str(TABLE.relative_to(ROOT)))),
          file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
