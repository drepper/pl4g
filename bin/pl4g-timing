#!/usr/bin/python3
"""Measure how long the compiler takes, and record it against the commit.

The table it keeps has one row per sample program and one column per commit, so
that a change which makes the compiler slower is visible as a column rather than
having to be remembered.  Both axes grow: a sample added later simply has no
figure for the commits before it.

Two numbers are kept for each sample.  *Work* is the sum of the compiler's own
stages, which is what a change to the compiler moves.  *Process* is the whole
run, which is what someone waiting for the compiler actually waits for; for the
bootstrap compiler it is dominated by starting the interpreter and importing the
package, so it says little about a change to code generation and a great deal
about how much of the compiler gets imported.

The best of several runs is recorded rather than the mean: the best is the one
least disturbed by whatever else the machine was doing, and the question here is
how long the work takes, not how busy the machine was.
"""

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

#: Where the figures are kept.  The JSON is what is read back and appended to;
#: the Markdown beside it is what anyone actually reads.
DATA = ROOT / "spec" / "timings.json"
TABLE = ROOT / "spec" / "timings.md"

#: The programs that are measured, and why each is here.  A sample is added
#: when a feature lands that could plausibly cost time, and never removed, so
#: that the column for an old commit stays meaningful.
SAMPLES: dict[str, str] = {
    "exit0": "the smallest conforming program",
    "global-variable": "one variable, read once",
    "assign-widths": "a store of every width",
    "many-values-at-once": "four values live at once, which the allocator places",
    "unreached-function": "a function and a variable that are dropped",
    "export-visibility": "several definitions, some exported",
    "digit-separators": "literals in every base",
    "boolean-values": "truth values in both sections",
    "bitwise-operators": "an expression with four operators and two variables",
    "bitwise-precedence": "an expression the folder collapses entirely",
}

#: How many times each sample is compiled.  The best is kept.
RUNS = 5


def sample_path(name: str) -> Path:
    """Where the program called *name* lives."""
    return ROOT / "tests" / "language" / name / "".join((name, ".pl4g"))


def commit() -> str:
    """The short hash of the commit being measured, marked if the tree is dirty."""
    short = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
                           capture_output=True, text=True, check=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", str(ROOT), "status", "--porcelain",
                            "--untracked-files=no"],
                           capture_output=True, text=True, check=True).stdout.strip()
    return "".join((short, "+" if dirty else ""))


def subject(rev: str = "HEAD") -> str:
    """The first line of the commit message, to say what a column is.

    Signature verification is turned off for this call: where the repository is
    configured to show it, it lands in the output and would become the subject.
    """
    return subprocess.run(["git", "-C", str(ROOT), "log", "-1",
                           "--no-show-signature", "--format=%s", rev],
                          capture_output=True, text=True, check=True).stdout.strip()


def work_of(stderr: str) -> float:
    """The sum of the stage timings the compiler reported."""
    total = 0.0
    for line in stderr.splitlines():
        parts = line.split(" ms  ", 1)
        if len(parts) == 2:
            try:
                total += float(parts[0])
            except ValueError:
                continue
    return total


def measure(name: str, triple: str, output: Path) -> tuple[float, float] | None:
    """The best work and process times of compiling *name*, in milliseconds."""
    source = sample_path(name)
    if not source.exists():
        return None
    command = [sys.executable, "-m", "pypl4g", "--time-report", "-o", str(output),
               "".join(("--target=", triple)), str(source)]
    best_work: float | None = None
    best_process: float | None = None
    for _ in range(RUNS):
        start = time.perf_counter()
        proc = subprocess.run(command, capture_output=True, text=True, cwd=ROOT)
        elapsed = (time.perf_counter() - start) * 1000
        if proc.returncode != 0:
            return None
        work = work_of(proc.stderr)
        best_work = work if best_work is None else min(best_work, work)
        best_process = elapsed if best_process is None else min(best_process, elapsed)
    assert best_work is not None and best_process is not None
    return best_work, best_process


def load() -> dict[str, object]:
    """The figures recorded so far."""
    if not DATA.exists():
        return {"samples": {}, "commits": [], "times": {}}
    return json.loads(DATA.read_text(encoding="utf-8"))


def _table(title: str, note: str, samples: dict[str, str], heads: list[str],
           times: dict[str, dict[str, list[float]]], column: int,
           digits: int) -> list[str]:
    """One table: a row per sample, a column per commit."""
    lines = [title, "-" * len(title), "", note, "",
             "".join(("| program | ", " | ".join(heads), " |")),
             "".join(("|---|", "---|" * len(heads)))]
    for name in samples:
        row = [name]
        for head in heads:
            found = times.get(head, {}).get(name)
            row.append(format(found[column], "".join((".", str(digits), "f")))
                       if found is not None else "")
        lines.append("".join(("| ", " | ".join(row), " |")))
    lines.append("")
    return lines


def render(data: dict[str, object]) -> str:
    """The tables, as Markdown."""
    commits = list(data["commits"])  # type: ignore[arg-type]
    times: dict[str, dict[str, list[float]]] = data["times"]  # type: ignore[assignment]
    samples: dict[str, str] = data["samples"]  # type: ignore[assignment]
    heads = [c["hash"] for c in commits]  # type: ignore[index]
    lines = [
        "Compiler Timings",
        "================",
        "",
        "How long the compiler takes on each sample program, in milliseconds, the",
        "best of five runs.  One column per commit, added by `bin/pl4g-timing`; a",
        "blank means the sample did not exist yet at that commit.  Measured on one",
        "machine, so the numbers are worth comparing with each other and with",
        "nobody else's.",
        "",
        "A hash ending in `+` was measured with changes not yet committed.",
        "",
    ]
    lines += _table(
        "Work", "The sum of the compiler's own stages, which is what a change to the\n"
        "compiler moves.", samples, heads, times, 0, 2)
    lines += _table(
        "Process", "The whole run, which is what someone waiting for the compiler waits\n"
        "for.  For the bootstrap compiler this is mostly starting the interpreter and\n"
        "importing the package, so it says little about code generation and a good deal\n"
        "about how much of the compiler an ordinary compilation has to import.",
        samples, heads, times, 1, 0)
    lines.append("What each column is:")
    lines.append("")
    for entry in commits:
        lines.append("".join(("- `", entry["hash"], "` -- ",  # type: ignore[index]
                              entry["subject"])))  # type: ignore[index]
    lines.append("")
    lines.append("What each sample exercises:")
    lines.append("")
    for name, why in samples.items():
        lines.append("".join(("- `", name, "` -- ", why)))
    return "\n".join(lines) + "\n"


def main() -> int:
    """Measure and record."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", default="x86_64-linux-none",
                        help="the triple to compile for")
    parser.add_argument("--dry-run", action="store_true",
                        help="measure and print, without recording")
    args = parser.parse_args()

    data = load()
    samples: dict[str, str] = data["samples"]  # type: ignore[assignment]
    for name, why in SAMPLES.items():
        samples.setdefault(name, why)

    head = commit()
    measured: dict[str, list[float]] = {}
    import tempfile
    with tempfile.TemporaryDirectory() as directory:
        output = Path(directory) / "out"
        for name in samples:
            found = measure(name, args.target, output)
            if found is None:
                print("".join(("       -        -  ", name)), file=sys.stderr)
                continue
            measured[name] = [found[0], found[1]]
            print("".join((format(found[0], "8.2f"), " ms work  ",
                           format(found[1], "6.0f"), " ms total  ", name)),
                  file=sys.stderr)

    if args.dry_run:
        return 0

    commits: list[dict[str, str]] = data["commits"]  # type: ignore[assignment]
    times: dict[str, dict[str, list[float]]] = data["times"]  # type: ignore[assignment]
    commits[:] = [c for c in commits if c["hash"] != head]
    commits.append({"hash": head, "subject": subject()})
    times[head] = measured
    DATA.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n",
                    encoding="utf-8")
    TABLE.write_text(render(data), encoding="utf-8")
    print("".join(("recorded ", head, " in ", str(TABLE.relative_to(ROOT)))),
          file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
