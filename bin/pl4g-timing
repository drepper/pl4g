#!/usr/bin/python3
"""Measure how long the compiler takes, and record it against the commit.

The table it keeps has one row per sample program and one column per commit, so
that a change which makes the compiler slower is visible as a column rather than
having to be remembered.  Both axes grow: a sample added later simply has no
figure for the commits before it.

Two numbers are kept for each sample.  *Work* is the sum of the compiler's own
stages, which is what a change to the compiler moves.  *Process* is the whole
run, which is what someone waiting for the compiler actually waits for; for the
bootstrap compiler it is dominated by starting the interpreter and importing the
package, so it says little about a change to code generation and a great deal
about how much of the compiler gets imported.

The best of several runs is recorded rather than the mean: the best is the one
least disturbed by whatever else the machine was doing, and the question here is
how long the work takes, not how busy the machine was.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import textwrap
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Final

ROOT = Path(__file__).resolve().parent.parent

#: Where the figures are kept.  The JSON is what is read back and appended to;
#: the Markdown beside it is what anyone actually reads.
DATA = ROOT / "spec" / "timings.json"
TABLE = ROOT / "spec" / "timings.md"

@dataclass(frozen=True, slots=True)
class Group:
    """A few programs that move together, and what makes them a group.

    The tables have a commit per row and a program per column, because the
    commits go on for ever and the programs do not: a column for every commit
    would be unreadable within a month.  Programs are grouped so that no one
    table is wide, and grouped by *what would move them* rather than by what
    they look like -- a group is useful exactly when a change to one part of
    the compiler moves its numbers together.
    """

    title: str
    note: str
    samples: dict[str, str]


#: The programs that are measured, why each is here, and what they say together.
#: A sample is added when a feature lands that could plausibly cost time, and
#: never removed, so that an older row stays meaningful.
