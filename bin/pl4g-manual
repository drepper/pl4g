#!/usr/bin/env python3
"""Make the manual: the nodes of a graph of short texts, from `help` down.

Run as ``pl4g-manual [--check] [--out DIR]``.  The manual is what a program
asking for help is shown, a node at a time: `help` is the top, every node is
reached from it by following the names it mentions, and none is more than four
kilobytes, so that each is something to read on one screen and not a chapter.

**Two kinds of node, and both are made every time.**  What the language is and
how it is used is written by hand, a file per node in `share/manual/`; what the
library offers is taken from the modules themselves (`modules/*.pl4g`): every
definition a module exports and documents with a `※※` comment is a node, and
every module is a node listing them, so that a function added to a module is in
the manual the next time it is made, and a function changed is changed there.
A hand-written node named after a module says what the module is for in place
of the summary its own comment gives.

**A link is a name in double brackets**, `[[std.string]]`, and stays one in the
text served: the reader asks for what it names.  What is checked:

- every link names a node, and every node is reached from `help`;
- no node is more than `LIMIT` bytes -- a module's list of members is split over
  as many nodes as it takes, each linked from the one before, and a hand-written
  node that is too long is refused, being the writer's to split;
- every builtin the compiler knows (`⎕name`), every attribute and every keyword
  is mentioned in some node, so that one added to the language and not to the
  manual is found by the next build and not by the next reader.

**A complete program in a node is written under a line `Program:`**, indented
by four spaces, and what it prints under a line `Output:` after it, indented the
same way.  `programs` finds them, and `tests/compiler/test_manual.py` compiles
each, runs it and holds it to its output and to the status nought -- so that an
example the language has moved away from is found by the next run of the suite.
A fragment that is no whole program is indented without the line above it, and
nothing compiles it.

With `--out DIR` the nodes are written there, one file each, named as the node
is, and packed into `DIR/manual.pack` -- each name, a nul, its text, a nul, in
the order of the names -- which the library serving them embeds; and
`DIR/manual.stamp.hh` holds the pack's SHA-256, which that library includes so
that a compiler cache sees the pack change.  With
`--check` nothing is written and the status says whether all of it holds.
"""

from __future__ import annotations

import argparse
import hashlib
import re
import sys
from collections import deque
from dataclasses import dataclass, field
from pathlib import Path
from typing import Final

ROOT: Final[Path] = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from pypl4g.front import token  # noqa: E402
from pypl4g.front.doccomment import parse as parse_doc  # noqa: E402
from pypl4g.sema.attributes import REGISTRY  # noqa: E402

#: Where the hand-written nodes are, and the modules.
SOURCES: Final[Path] = ROOT / "share" / "manual"
MODULES: Final[Path] = ROOT / "modules"

#: The most a node may hold, in bytes of UTF-8.
LIMIT: Final[int] = 4096

#: The node everything is reached from.
TOP: Final[str] = "help"

#: A link, as a node writes one.
LINK: Final[re.Pattern[str]] = re.compile(r"\[\[([^\[\]\s]+)\]\]")

#: What a definition's first line begins with, and the name after it.
DEFINITION: Final[re.Pattern[str]] = re.compile(
    r"^(fn|type|enum|let|unit|bundle|macro)\s+(`[^`]+`|[\w.⍕]+)")

#: What `std` hands on: `@[export] let NAME := ⎕import("FILE")`.
HANDED_ON: Final[re.Pattern[str]] = re.compile(r'^let\s+(\w+)\s*:=\s*⎕import\("(\w+)"\)')


@dataclass(slots=True)
class Node:
    """One text of the manual."""

    name: str
    title: str
    body: str
    #: Where it came from, for a message about it.
    origin: str
    links: list[str] = field(default_factory=list)

    def text(self) -> str:
        """The text served: the title, underlined, and the body."""
        return "".join((self.title, "\n", "=" * len(self.title), "\n\n", self.body.strip("\n").rstrip(), "\n"))


@dataclass(slots=True)
class Definition:
    """Something a module exports, with what its comment says of it."""

    name: str
    kind: str
    headers: list[str]
    doc: str


#: What a node's title says a definition is, by the word it is written with.
KINDS: Final[dict[str, str]] = {
    "fn": "function", "type": "type", "enum": "enumeration", "let": "variable",
    "unit": "unit", "bundle": "bundle", "macro": "macro"}

#: The order a module's contents are listed in, by kind, and the heading of each.
SECTIONS: Final[tuple[tuple[str, str], ...]] = (
    ("module", "Modules it hands on"), ("type", "Types"), ("enum", "Enumerations"),
    ("fn", "Functions"), ("macro", "Macros"), ("let", "Variables"), ("unit", "Units"),
    ("bundle", "Bundles"))

#: A name a comment quotes, `like.this`, which may be a node's.
QUOTED: Final[re.Pattern[str]] = re.compile(r"`([A-Za-z_][\w.]*)(?:\(\))?`")

#: What begins a complete program in a node, and the output it prints.
PROGRAM: Final[str] = "Program:"
OUTPUT: Final[str] = "Output:"

#: How far a program and its output are indented under the line naming them.
INDENT: Final[str] = "    "


def hand_written() -> dict[str, Node]:
    """The nodes in `share/manual/`, each file `NAME.txt` holding the node NAME:
    a `title:` line, a blank line, and the body."""
    nodes: dict[str, Node] = {}
    for path in sorted(SOURCES.glob("*.txt")):
        lines = path.read_text(encoding="utf-8").split("\n")
        if not lines or not lines[0].startswith("title:"):
            raise SystemExit("".join((str(path), ": the first line is not 'title: ...'")))
        name = path.stem
        nodes[name] = Node(name=name, title=lines[0][len("title:"):].strip(),
                           body="\n".join(lines[1:]).strip("\n"), origin=str(path))
    return nodes


def module_names() -> dict[Path, str]:
    """What each module is called by a program: `std.NAME` for one std hands on,
    its own name for any other."""
    names = {MODULES / "std.pl4g": "std"}
    exported = False
    for line in (MODULES / "std.pl4g").read_text(encoding="utf-8").split("\n"):
        if line.startswith("@[") and "export" in line:
            exported = True
            continue
        found = HANDED_ON.match(line)
        if found is not None and exported:
            names[MODULES / "".join((found.group(2), ".pl4g"))] = "".join(("std.", found.group(1)))
        if line.strip() and not line.startswith("※"):
            exported = False
    for path in sorted(MODULES.glob("*.pl4g")):
        names.setdefault(path, path.stem)
    return names


def comment_text(lines: list[str]) -> str:
    """What the documentation comments among *lines* say, without their marks.

    Only `※※` documents: a `※` line among them is a remark about how the thing
    is made, for whoever reads the module, and stays out of the manual."""
    out: list[str] = []
    for line in lines:
        text = line.lstrip()
        if not text.startswith("※※"):
            continue
        text = text[2:]
        out.append(text[1:] if text.startswith(" ") else text)
    return "\n".join(out).strip()


def bracket_depth(line: str) -> int:
    """How many brackets *line* opens and does not close."""
    return sum(line.count(o) - line.count(c) for o, c in ("()", "[]", "⟦⟧", "⸨⸩"))


def definitions(path: Path) -> tuple[str, list[Definition]]:
    """What a module says of itself, and what it exports with a comment."""
    lines = path.read_text(encoding="utf-8").split("\n")
    overview = ""
    found: list[Definition] = []
    at = 0
    doc: list[str] = []
    while at < len(lines):
        line = lines[at]
        if line.startswith("※※"):
            doc = [line]
            at += 1
            while at < len(lines) and lines[at].startswith("※"):
                doc.append(lines[at])
                at += 1
            continue
        if not line.strip():
            if doc and not overview and not found:
                overview = comment_text(doc)
            doc = [] if not line.strip() and doc and lines[at - 1].startswith("※") else doc
            at += 1
            continue
        attributes: list[str] = []
        while at < len(lines) and lines[at].startswith("@["):
            attributes.append(lines[at])
            at += 1
        if at >= len(lines):
            break
        head = DEFINITION.match(lines[at])
        if head is None or not any(re.search(r"\bexport\b", one) for one in attributes):
            doc = []
            at += 1
            continue
        kind = head.group(1)
        if kind == "let" and "⎕import(" in lines[at]:
            kind = "module"
        headers = [lines[at]]
        depth = bracket_depth(lines[at])
        at += 1
        # A header goes on where a bracket is still open; a type whose fields or
        # alternatives are on lines of their own goes on with them, the remarks
        # about each among them; and a function's conditions on lines of their
        # own are part of what a caller reads.
        while at < len(lines):
            more = lines[at]
            if depth > 0:
                pass
            elif kind in ("type", "enum") and more.startswith((" ", "\t")):
                pass
            elif kind in ("fn", "macro") and more.lstrip().startswith(("pre(", "post(")) \
                    and more.startswith((" ", "\t")):
                pass
            else:
                break
            headers.append(more)
            depth += bracket_depth(more)
            at += 1
        if kind in ("fn", "macro") and headers[-1].rstrip().endswith(":"):
            headers[-1] = headers[-1].rstrip()[:-1]
        found.append(Definition(name=head.group(2).strip("`"), kind=kind,
                                headers=[one.rstrip() for one in headers], doc=comment_text(doc)))
        doc = []
    return overview, found


def first_paragraphs(text: str, count: int) -> str:
    """The first *count* paragraphs of *text*."""
    return "\n\n".join(text.split("\n\n")[:count]).strip()


def said(text: str) -> str:
    """What a command of a comment says, on one line: its first paragraph, the
    rest of a comment after a command being prose about the definition again."""
    return " ".join(first_paragraphs(text, 1).split())


def brief_of(doc: str) -> str:
    """The first paragraph of a comment's summary, on one line, for a list."""
    return said(parse_doc(doc).summary)


def signature(headers: list[str]) -> str:
    """A definition's header as a node shows it: indented, as the module writes it."""
    return "\n".join("".join((INDENT, line)) for line in headers)


#: How wide the prose a node makes from a comment is.
WIDTH: Final[int] = 78


def filled(text: str, indent: str = "", first: str = "") -> str:
    """*text* filled to `WIDTH`, keeping the two spaces this project's prose
    puts between sentences; *first* begins the first line and *indent* every
    line after it."""
    lines: list[str] = []
    line = first
    # A span in backticks is one word, so that a line never breaks inside one.
    for word, gap in re.findall(r"((?:[^`\s]*`[^`]*`)+[^`\s]*|\S+)(\s*)", text):
        if line and len(line) + len(word) > WIDTH:
            lines.append(line.rstrip())
            line = indent
        line = "".join((line, word, "  " if len(gap) > 1 else " "))
    lines.append(line.rstrip())
    return "\n".join(lines)


def reflowed(text: str) -> str:
    """*text* with each paragraph filled to `WIDTH` again: a comment's command
    takes the start of its first line, which leaves that line short.  A list's
    items are filled each with its own hanging indent; an indented block is
    left as it is."""
    out: list[str] = []
    for paragraph in text.split("\n\n"):
        lines = paragraph.split("\n")
        if any(line.startswith((" ", "\t")) for line in lines):
            out.append(paragraph)
            continue
        items: list[list[str]] = []
        for line in lines:
            if line.startswith("- ") or not items:
                items.append([line])
            else:
                items[-1].append(line)
        made: list[str] = []
        for item in items:
            # A sentence that ended a line ends with two spaces once joined.
            joined = ""
            for line in item:
                if joined:
                    joined += "  " if joined.rstrip().endswith((".", "?", "!")) else " "
                joined += line.strip()
            made.append(filled(joined, "  " if joined.startswith("- ") else ""))
        out.append("\n".join(made))
    return "\n\n".join(out)


def described(doc: str) -> list[str]:
    """The paragraphs a comment says of a definition, in the order a reader wants
    them: what it is, the details, what it takes, what it answers and refuses,
    and the remarks."""
    parsed = parse_doc(doc)
    parts: list[str] = []
    if parsed.summary:
        parts.append(reflowed(parsed.summary.strip()))
    for part in parsed.of("details"):
        if part.text.strip():
            parts.append(reflowed(part.text.strip()))
    params = parsed.of("param")
    if params:
        width = max(len(p.subject) for p in params)
        parts.append("\n".join(("Parameters:",
                                *(filled(said(p.text), " " * (width + 4),
                                         "".join(("  ", p.subject.ljust(width), "  ")))
                                  for p in params))))
    for command, label in (("return", "Answers"), ("raises", "Fails with"), ("pre", "Requires"),
                           ("post", "Promises"), ("note", "Note"), ("warning", "Warning"),
                           ("see", "See")):
        for part in parsed.of(command):
            parts.append(filled("".join((label, ": ", said(part.text))), "  "))
    return parts


def definition_node(module: str, same: list[Definition]) -> Node:
    """The node of a definition of *module*: each definition of the name with
    what its own comment says, a comment the same as the one before said once."""
    parts: list[str] = []
    before = None
    for one in same:
        parts.append(signature(one.headers))
        if one.doc and one.doc != before:
            parts.extend(described(one.doc))
        before = one.doc
    name = "".join((module, ".", same[0].name))
    kinds = sorted({KINDS.get(one.kind, one.kind) for one in same})
    return Node(name=name, title="".join((name, " -- ", " and ".join(kinds))),
                body="\n\n".join(parts), origin=str(MODULES))


def library_nodes(hand: dict[str, Node]) -> dict[str, Node]:
    """A node for every module and for everything each exports with a comment."""
    nodes: dict[str, Node] = {}
    for path, module in sorted(module_names().items(), key=lambda item: item[1]):
        overview, found = definitions(path)
        grouped: dict[str, list[Definition]] = {}
        for one in found:
            grouped.setdefault(one.name, []).append(one)
        listing: dict[str, list[str]] = {}
        for name, same in grouped.items():
            brief = brief_of(next((one.doc for one in same if one.doc), ""))
            if same[0].kind == "module":
                node_name = "".join((module, ".", name))
            else:
                node = definition_node(module, same)
                nodes[node.name] = node
                node_name = node.name
            listing.setdefault(same[0].kind, []).append(
                "".join(("  [[", node_name, "]]", " -- " if brief else "", brief)))
        intro = hand.pop(module).body if module in hand else first_paragraphs(overview, 2)
        lines: list[str] = []
        for kind, heading in SECTIONS:
            if kind in listing:
                lines.extend(("", "".join((heading, ":")), *listing[kind]))
        nodes.update(split_listing(module, "".join(("The module ", module)), intro,
                                   lines[1:], module))
    return nodes


def split_listing(name: str, title: str, intro: str, listing: list[str],
                  back: str) -> dict[str, Node]:
    """A node of *intro* and *listing*, split over as many as it takes to keep
    each within `LIMIT`: NAME, then NAME.more, NAME.more2 and on, each linked
    from the one before."""
    nodes: dict[str, Node] = {}
    part, at, first = 1, 0, True
    while True:
        own = name if part == 1 else "".join((name, ".more", "" if part == 2 else str(part - 1)))
        after = "".join((name, ".more", "" if part == 1 else str(part)))
        lines: list[str] = []
        head = intro if first else "".join(("More of [[", back, "]]."))
        budget = LIMIT - len(Node(own, title, "", "").text().encode()) - len(head.encode()) - 200
        # A part that begins in the middle of a section says which it is.
        if not first and at < len(listing) and not listing[at].endswith(":"):
            heading = next((one for one in reversed(listing[:at]) if one.endswith(":")), "")
            if heading:
                lines.append("".join((heading[:-1], ", continued:")))
                budget -= len(lines[-1].encode()) + 1
        while at < len(listing) and budget - len(listing[at].encode()) - 1 > 0:
            budget -= len(listing[at].encode()) + 1
            lines.append(listing[at])
            at += 1
        while lines and not lines[-1]:
            lines.pop()
        body = "\n\n".join((head, "\n".join(lines) if lines else "It exports nothing."))
        if at < len(listing):
            body = "".join((body, "\n\nContinued in [[", after, "]]."))
        nodes[own] = Node(name=own, title=title if first else "".join((title, ", continued")),
                          body=body, origin=str(MODULES))
        if at >= len(listing):
            return nodes
        part += 1
        first = False


def related(nodes: dict[str, Node]) -> None:
    """End each node made from a module with the nodes its comment names and the
    module it is part of, so that a definition leads to the ones it is used with."""
    modules = set(module_names().values())
    for node in nodes.values():
        if node.origin != str(MODULES) or node.name in modules or ".more" in node.name:
            continue
        module = max((one for one in modules if node.name.startswith(one + ".")), key=len)
        seen: list[str] = []
        for word in QUOTED.findall(node.body):
            for candidate in ("".join((module, ".", word)), "".join(("std.", word)), word):
                if candidate in nodes and candidate != node.name and candidate != module:
                    if candidate not in seen:
                        seen.append(candidate)
                    break
        tail = "".join(("Part of [[", module, "]]."))
        if seen:
            tail = "".join(("See also ", ", ".join("".join(("[[", one, "]]")) for one in seen),
                            ".\n", tail))
        node.body = "\n\n".join((node.body, tail))


def programs(text: str) -> list[tuple[str, str | None]]:
    """The complete programs a node holds, each with the output it says it
    prints where it says, as `Program:` and `Output:` blocks write them."""
    lines = text.split("\n")
    found: list[tuple[str, str | None]] = []
    at = 0

    def block(start: int) -> tuple[str, int]:
        """The block indented under the line before *start*, and where it ends."""
        taken: list[str] = []
        at = start
        while at < len(lines) and (not lines[at].strip() or lines[at].startswith(INDENT)):
            taken.append(lines[at][len(INDENT):])
            at += 1
        while taken and not taken[-1].strip():
            taken.pop()
        while taken and not taken[0].strip():
            taken.pop(0)
        return "\n".join(taken) + "\n" if taken else "", at

    while at < len(lines):
        if lines[at].strip() == PROGRAM:
            program, at = block(at + 1)
            output: str | None = None
            if at < len(lines) and lines[at].strip() == OUTPUT:
                output, at = block(at + 1)
            found.append((program, output))
        else:
            at += 1
    return found


def mentions_wanted() -> dict[str, str]:
    """What the manual has to mention somewhere, and what each is."""
    wanted: dict[str, str] = {}
    for value in vars(token).values():
        if isinstance(value, str) and value.startswith(token.BUILTIN_GLYPH) and len(value) > 1 \
                and re.fullmatch(r"⎕[a-z_]+", value):
            wanted[value] = "the builtin"
    for name in REGISTRY:
        wanted["".join(("@[", name))] = "the attribute"
    for word in token.KEYWORDS:
        if re.fullmatch(r"[a-z_]+", word):
            wanted[word] = "the keyword"
    return wanted


def mentioned(word: str, texts: str) -> bool:
    """Whether *texts* mentions *word*: an attribute as `@[name` or `, name` inside
    one, anything else as a word of its own."""
    if word.startswith("@["):
        return re.search("".join((r"@\[[^\]]*\b", re.escape(word[2:]), r"\b")), texts) is not None
    return re.search("".join((r"(?<![\w⎕])", re.escape(word), r"(?!\w)")), texts) is not None


def check(nodes: dict[str, Node]) -> list[str]:
    """What is wrong with the graph, as messages."""
    wrong: list[str] = []
    for node in nodes.values():
        node.links = LINK.findall(node.body)
        for link in node.links:
            if link not in nodes:
                wrong.append("".join((node.origin, ": ", node.name, " links to '", link,
                                      "', which is no node")))
        size = len(node.text().encode("utf-8"))
        if size > LIMIT:
            wrong.append("".join((node.origin, ": ", node.name, " is ", str(size), " bytes, more than ",
                                  str(LIMIT), "; split it")))
    if TOP not in nodes:
        wrong.append("".join(("there is no node '", TOP, "'")))
        return wrong
    seen = {TOP}
    waiting = deque([TOP])
    while waiting:
        for link in nodes[waiting.popleft()].links:
            if link in nodes and link not in seen:
                seen.add(link)
                waiting.append(link)
    for name in sorted(set(nodes) - seen):
        wrong.append("".join((nodes[name].origin, ": ", name, " is not reached from ", TOP)))
    for node in nodes.values():
        for program, _ in programs(node.body):
            if not program:
                wrong.append("".join((node.origin, ": ", node.name, " has a '", PROGRAM,
                                      "' line with no program indented under it")))
    texts = "\n".join(node.text() for node in nodes.values())
    for word, what in mentions_wanted().items():
        if not mentioned(word, texts):
            wrong.append("".join(("no node mentions ", what, " '",
                                  word if not word.startswith("@[") else word + "]", "'")))
    return wrong


def made() -> dict[str, Node]:
    """Every node: the hand-written ones and the library's."""
    hand = hand_written()
    library = library_nodes(hand)
    clash = sorted(set(hand) & set(library))
    if clash:
        raise SystemExit("".join(("written by hand and made from a module: ", ", ".join(clash))))
    nodes = {**hand, **library}
    related(nodes)
    return nodes


def pack(nodes: dict[str, Node]) -> bytes:
    """The nodes as the library embeds them: name, nul, text, nul, by name."""
    out = bytearray()
    for name in sorted(nodes):
        out += name.encode("utf-8") + b"\0" + nodes[name].text().encode("utf-8") + b"\0"
    return bytes(out)


def main() -> int:
    parser = argparse.ArgumentParser(description="Make the manual, and check its graph.")
    parser.add_argument("--check", action="store_true", help="only check; write nothing")
    parser.add_argument("--out", type=Path, help="where to write the nodes and manual.pack")
    args = parser.parse_args()
    nodes = made()
    wrong = check(nodes)
    for one in wrong:
        print(one, file=sys.stderr)
    if wrong:
        return 1
    if args.out is not None and not args.check:
        args.out.mkdir(parents=True, exist_ok=True)
        for stale in args.out.glob("*.txt"):
            if stale.stem not in nodes:
                stale.unlink()
        for name, node in nodes.items():
            target = args.out / "".join((name, ".txt"))
            text = node.text()
            if not target.exists() or target.read_text(encoding="utf-8") != text:
                target.write_text(text, encoding="utf-8")
        packed = pack(nodes)
        target = args.out / "manual.pack"
        if not target.exists() or target.read_bytes() != packed:
            target.write_bytes(packed)
        # A compiler cache hashes what a source includes and not what it
        # embeds, so the source including this sees the manual change.
        stamp = "".join(("// The SHA-256 of manual.pack, which src/manual/manual.cc embeds: included\n",
                         "// there so that a compiler cache, which hashes what is included and not\n",
                         "// what is embedded, compiles it again when the manual changes.\n",
                         "#define PL4G_MANUAL_STAMP \"", hashlib.sha256(packed).hexdigest(), "\"\n"))
        target = args.out / "manual.stamp.hh"
        if not target.exists() or target.read_text(encoding="utf-8") != stamp:
            target.write_text(stamp, encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main())
