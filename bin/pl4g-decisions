#!/usr/bin/python3
"""Show a program's source with what the compiler decided about it.

A decision log says what the compiler left out and why, but a list of names and
line numbers is not something anyone reads.  This puts each record back where it
belongs -- against the line it is about -- so that the question it answers, "I
wrote that, where did it go?", is answered by looking at the place it was
written.

The sources are found through the directory the log records, so the log can be
read from anywhere and on another machine.  Where the output is a terminal the
source is highlighted using the tree-sitter grammar in `tree-sitter-pl4g`; where
it is a file or a pipe it is not, unless asked for.
"""

import argparse
import fnmatch
import json
import os
import sys
import warnings
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
GRAMMAR = ROOT / "tree-sitter-pl4g"

#: What each capture of the highlight queries is shown as.  The names are
#: tree-sitter's own, so the same queries an editor uses drive this.
STYLES: dict[str, str] = {
    "comment": "\033[2;37m",
    "comment.documentation": "\033[2;36m",
    "keyword": "\033[1;34m",
    "keyword.modifier": "\033[1;34m",
    "function": "\033[1;33m",
    "type": "\033[36m",
    "attribute": "\033[35m",
    "property": "\033[35m",
    "number": "\033[32m",
    "string": "\033[32m",
    "boolean": "\033[32m",
    "operator": "\033[1;37m",
    "variable": "",
    "variable.parameter": "\033[3m",
    "punctuation.bracket": "\033[2m",
    "punctuation.delimiter": "\033[2m",
}

RESET = "\033[0m"
#: How a decision record is set off from the source around it.
DECISION = "\033[1;31m"
GUTTER = "\033[2m"


@dataclass(frozen=True, slots=True)
class Record:
    """One decision, as the log states it."""

    kind: str
    subject: str
    reason: str
    file: str | None
    line: int | None


@dataclass(slots=True)
class Log:
    """A decision log, with its records grouped by the file they are about."""

    directory: Path
    inputs: list[str] = field(default_factory=list)
    by_file: dict[str, list[Record]] = field(default_factory=dict)
    loose: list[Record] = field(default_factory=list)


def read_log(path: Path) -> Log:
    """Read a decision log and group what it says by file."""
    document = json.loads(path.read_text(encoding="utf-8"))
    version = document.get("format_version")
    if version not in (1, 2):
        raise SystemExit("".join((
            str(path), ": format version ", str(version),
            " is not one this program knows")))
    # Version 1 did not record where the compiler ran, so paths in it can only
    # be resolved against the directory the log itself is in.
    directory = Path(document["directory"]) if "directory" in document else path.parent
    log = Log(directory=directory, inputs=list(document.get("inputs", ())))
    for entry in document.get("decisions", ()):
        where = entry.get("where") or {}
        record = Record(kind=entry["kind"], subject=entry["subject"],
                        reason=entry["reason"], file=where.get("file"),
                        line=where.get("line"))
        if record.file is None or record.line is None:
            log.loose.append(record)
        else:
            log.by_file.setdefault(record.file, []).append(record)
    # The compiler records them in the order it decided them, which is the order
    # of its passes; a reader wants them in the order of the file.
    for records in log.by_file.values():
        records.sort(key=lambda r: (r.line or 0, r.kind, r.subject))
    return log


def resolve(log: Log, name: str) -> Path:
    """Where a file the log names actually is.

    A path that is not absolute is relative to the directory the compiler ran
    in, which is what makes the log readable from anywhere.
    """
    path = Path(name)
    return path if path.is_absolute() else log.directory / path


def wanted(name: str, patterns: list[str]) -> bool:
    """Whether a file is one the reader asked to see."""
    if not patterns:
        return True
    return any(fnmatch.fnmatch(name, p) or fnmatch.fnmatch(Path(name).name, p)
               for p in patterns)


# -- highlighting ---------------------------------------------------------------

def highlighter():  # noqa: ANN201
    """A function from source text to a list of spans, or None if there is none.

    Highlighting wants three things -- the Python binding, the generated parser
    and the queries -- and any of them may be absent on a machine that only
    wants to read a log.  Missing any one of them is not an error: the source is
    shown without colour, which is what a pipe gets anyway.
    """
    try:
        from tree_sitter import Language, Parser, Query, QueryCursor
    except ImportError:
        return None
    try:
        import ctypes
        library = build_library()
        if library is None:
            return None
        loaded = ctypes.cdll.LoadLibrary(str(library))
        function = getattr(loaded, "tree_sitter_pl4g")
        function.restype = ctypes.c_void_p
        with warnings.catch_warnings():
            # Handing the binding a plain pointer is deprecated in favour of a
            # capsule from a packaged grammar; this grammar is built here rather
            # than packaged, so a pointer is what there is.
            warnings.simplefilter("ignore", DeprecationWarning)
            language = Language(function())
        parser = Parser(language)
        query = Query(language,
                      (GRAMMAR / "queries" / "highlights.scm").read_text(encoding="utf-8"))
    except Exception:
        return None

    def spans(text: str) -> list[tuple[int, int, str]]:
        """Every highlighted range of *text*, as byte offsets and a capture."""
        data = text.encode("utf-8")
        tree = parser.parse(data)
        found: list[tuple[int, int, str]] = []
        for name, nodes in QueryCursor(query).captures(tree.root_node).items():
            for node in nodes:
                found.append((node.start_byte, node.end_byte, name))
        # A later pattern wins where two cover one range, which is the rule
        # tree-sitter's own highlighter uses; sorting by width puts the
        # narrowest last so that it is the one that survives.
        found.sort(key=lambda s: (s[0], -(s[1] - s[0])))
        return found

    return spans


def build_library() -> Path | None:
    """Build the grammar into a shared library, if it is not built already."""
    import subprocess

    sources = [GRAMMAR / "src" / "parser.c"]
    scanner = GRAMMAR / "src" / "scanner.c"
    if scanner.exists():
        sources.append(scanner)
    if not sources[0].exists():
        return None
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "pl4g"
    cache.mkdir(parents=True, exist_ok=True)
    library = cache / "pl4g-grammar.so"
    newest = max(p.stat().st_mtime for p in sources)
    if library.exists() and library.stat().st_mtime >= newest:
        return library
    command = ["cc", "-shared", "-fPIC", "-O2", "-o", str(library),
               "-I", str(GRAMMAR / "src"), *[str(p) for p in sources]]
    try:
        proc = subprocess.run(command, capture_output=True, text=True, timeout=120)
    except OSError:
        return None
    return library if proc.returncode == 0 else None


def paint(text: str, spans: list[tuple[int, int, str]] | None) -> list[str]:
    """The lines of *text*, coloured where a span says to colour them."""
    if spans is None:
        return text.splitlines()
    data = text.encode("utf-8")
    pieces: list[bytes] = []
    position = 0
    for start, end, name in spans:
        if start < position:
            continue
        style = STYLES.get(name)
        if not style:
            continue
        pieces.append(data[position:start])
        pieces.append(style.encode("ascii"))
        pieces.append(data[start:end])
        pieces.append(RESET.encode("ascii"))
        position = end
    pieces.append(data[position:])
    return b"".join(pieces).decode("utf-8").splitlines()


# -- showing --------------------------------------------------------------------

def show_file(name: str, path: Path, records: list[Record], spans, colour: bool,  # noqa: ANN001
              stream) -> None:  # noqa: ANN001
    """Print one source file with its decisions against the lines they concern."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        print("".join((name, ": ", exc.strerror or str(exc))), file=sys.stderr)
        return
    lines = paint(text, spans(text) if spans is not None else None)
    at_line: dict[int, list[Record]] = {}
    for record in records:
        assert record.line is not None
        at_line.setdefault(record.line, []).append(record)

    header = "".join(("── ", name, " "))
    print("".join((GUTTER if colour else "", header, "─" * max(0, 76 - len(header)),
                   RESET if colour else "")), file=stream)
    width = len(str(len(lines)))
    for number, line in enumerate(lines, start=1):
        gutter = str(number).rjust(width)
        print("".join((GUTTER if colour else "", gutter, " │ ",
                       RESET if colour else "", line)), file=stream)
        for record in at_line.get(number, ()):
            print(_decision_line(record, width, colour), file=stream)
    print(file=stream)


def _decision_line(record: Record, width: int, colour: bool) -> str:
    """One decision, written under the line it is about."""
    lead = "".join((" " * width, " │ "))
    body = "".join(("◀ ", record.kind, ": ", record.subject, " — ", record.reason))
    if not colour:
        return "".join((lead, body))
    return "".join((GUTTER, lead, RESET, DECISION, body, RESET))


def main() -> int:
    """Read a log and show the sources it is about."""
    parser = argparse.ArgumentParser(
        description="show a program's source with the compiler's decisions in it")
    parser.add_argument("log", type=Path, help="the decision log to read")
    parser.add_argument("patterns", nargs="*", metavar="PATTERN",
                        help="show only source files matching one of these; a "
                             "pattern matches the path as the log states it or "
                             "the file name alone")
    parser.add_argument("--color", "--colour", dest="colour",
                        choices=("auto", "always", "never"), default="auto",
                        help="highlight the source (default: only on a terminal)")
    parser.add_argument("--only-decisions", action="store_true",
                        help="list the decisions without the source around them")
    args = parser.parse_args()

    log = read_log(args.log)
    colour = (args.colour == "always"
              or (args.colour == "auto" and sys.stdout.isatty()))
    spans = highlighter() if colour else None
    if colour and spans is None:
        print("pl4g-decisions: no grammar to highlight with; showing plain text",
              file=sys.stderr)

    names = [n for n in sorted(log.by_file) if wanted(n, args.patterns)]
    if args.only_decisions:
        for name in names:
            for record in log.by_file[name]:
                print("".join((name, ":", str(record.line), ": ", record.kind,
                               ": ", record.subject, " — ", record.reason)))
        return 0

    if not names and not log.loose:
        print("no decisions were recorded for the files asked for", file=sys.stderr)
    for name in names:
        show_file(name, resolve(log, name), log.by_file[name], spans, colour,
                  sys.stdout)
    # A decision about the program rather than about a place in it still has to
    # be shown, or it would be silently dropped by a filter it cannot match.
    if log.loose and not args.patterns:
        print("about the program as a whole:")
        for record in log.loose:
            print("".join(("  ", record.kind, ": ", record.subject, " — ",
                           record.reason)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
