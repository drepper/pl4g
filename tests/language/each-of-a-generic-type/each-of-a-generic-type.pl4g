※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ A type with type parameters says how it is walked the same way, its `each` generic in
※ the type's parameters -- `fn Two.each(t: Two(T'), a: &mut arena) ⇉ T'` -- and compiled
※ once for each instance a walk asks for: `Two(u8)` and `Two(u16)` are two.  A value of
※ an instance reaches the functions written under the definition it was made from.

let std := ⎕import("std")
type Two(T') = first : T' ; second : T'
type Row(T') = { items : [T'] }

fn Two.each(t: Two(T'), a: &mut arena) ⇉ T':
    yield t.first
    yield t.second

fn Row.each(r: &Row(T'), a: &mut arena) ⇉ T':
    foreach x := r⌖.items:
        yield x

fn total(s: ⇉u8) → u8:
    let t: mut u8 = 0u8
    foreach x := s:
        t ← t + x
    t

fn wide(s: ⇉u16) → u16:
    let t: mut u16 = 0u16
    foreach x := s:
        t ← t + x
    t

@[startup, impure]
fn main(init: std.Init) → u6:
    let pool: mut arena = ⎕arena
    defer ⎕empty(pool)
    let t: Two(u8) = Two(.first ← 2u8, .second ← 3u8)
    let w: Two(u16) = Two(.first ← 200u16, .second ← 300u16)
    let r: Row(u8) = Row(.items ← [1u8, 2u8, 3u8] in pool)
    if total(t) ≠ 5u8 ∨ wide(w) ≠ 500u16 ∨ total(&r) ≠ 6u8:
        return 1u6
    let n: mut u8 = 0u8
    foreach x := r:
        n ← n + x
    foreach _, x := ⎕enumerate(t):
        n ← n + x
    let g: ⇉ = t
    if total(g) ≠ 5u8 ∨ n ≠ 11u8:
        return 2u6
    let c := ⎕start(t in ⎕heap)
    let one: u8 = ⎕resume(c) ?? 0u8
    if one ≠ 2u8: 3u6 else: 0u6
