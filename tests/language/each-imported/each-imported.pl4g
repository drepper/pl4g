※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ A type another module exports is walked by the `each` written beside it, reached
※ through the module as any function inside the type is, and exported as they are:
※ `foreach x := s` over a `walks.Span` walks `walks.Span.each(s)`.  The body means what its own file's names
※ mean, so it is walked through calls rather than written into the loop.

let walks := ⎕import("walks")
let std := ⎕import("std")

fn total(s: ⇉u8) → u8:
    let t: mut u8 = 0u8
    foreach x := s:
        t ← t + x
    t

@[startup]
fn main(init: std.Init) → u6:
    let s: walks.Span = walks.Span(.from ← 2u8, .upto ← 5u8)
    let n: mut u8 = 0u8
    foreach x := s:
        n ← n + x
    if n ≠ 9u8:
        return 1u6
    if total(s) = 9u8: 0u6 else: 2u6
