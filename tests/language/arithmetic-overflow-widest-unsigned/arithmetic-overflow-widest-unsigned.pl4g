※ pl4g-test: compile=ok run=native,qemu exit=80 diag=none

※ And the widest unsigned type, where what says the sum went past is that it
※ came out below what it was given.

let big: u64 = 18000000000000000000u64

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    if big + big = big:
        1u6
    else:
        2u6
