※ `⎕fields` of a record type answers types, which only `comptime foreach` can
※ hold: there is no tuple of them to keep.

type Point = x : u8 ; y : u16

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let t := ⎕fields(⌜Point⌝)
    0u6
