※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ `std.print` and `std.println` write bytes to a device through the ring, wait for the
※ write to finish, and answer how many bytes went.
※
※ **What they add over `write_sync` is that they do not stop short.**  The kernel may take
※ fewer bytes than it was offered -- a pipe with room for some of them, a signal part way
※ -- and a program that printed a line wants the line printed, so what is left is offered
※ again until none is.
※
※ **`println` writes the newline in the same request**, as a second run of bytes rather
※ than a second call: `writev` takes a list of them, so the text and the newline reach the
※ kernel together and nothing else writing to the device can land between them.
※
※ The ring itself is not visible here and there is nothing to ask about it.  It is made the
※ first time anything reads or writes, used where the system has one, and stood in for by
※ the plain system call where it has not.

let std := ⎕import("std")

@[startup, impure]
fn main(init: &std.Init) → u6:
    ※ Into a pipe, so that what was written can be read back and counted.
    let ends: mut i32⟦2⟧ = ⟦0i32, 0i32⟧
    if ⎕syscall(⎕sc@pipe2, &mut ends⟦0⟧, 0i64) < 0i64:
        return 1u6
    let out: mut std.Writer = std.Writer(.fd ← ends⟦1⟧)
    let back: mut std.Reader = std.Reader(.fd ← ends⟦0⟧)

    let wrote: u64 ¤size = std.println(&mut out, ⎕bytes("ab")) ?? 0
    if ⎕drop(wrote) ≠ 3u64:
        return 2u6
    let again: u64 ¤size = std.print(&mut out, ⎕bytes("cd")) ?? 0
    if ⎕drop(again) ≠ 2u64:
        return 3u6
    ※ A newline on its own, which is the one place `println` writes a single run.
    if ⎕drop(std.println(&mut out, ⎕bytes("")) ?? 0) ≠ 1u64:
        return 4u6

    let seen: mut u8⟦8⟧ = ⟦0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8⟧
    let got: u64 ¤size = std.read(&mut back, seen) ?? 0
    if ⎕drop(got) ≠ 6u64:
        return 5u6
    if seen⟦0⟧ ≠ 97u8 ∨ seen⟦1⟧ ≠ 98u8 ∨ seen⟦2⟧ ≠ 10u8:
        return 6u6
    if seen⟦3⟧ ≠ 99u8 ∨ seen⟦4⟧ ≠ 100u8 ∨ seen⟦5⟧ ≠ 10u8:
        return 7u6
    0u6
