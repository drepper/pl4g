※ pl4g-test: compile=ok run=native,qemu exit=0 diag=none

※ A generator walked through calls may be left part way: a `return` out of the
※ loop walking it, a `break`.  Whichever way the loop is left, the generator is
※ resumed once more with nowhere to write to, which tells it to finish -- so
※ what it put off with `defer` runs, once, as it would have at its end.

let opened: mut u8 = 0u8
let closed: mut u8 = 0u8

@[impure]
fn open():
    opened ← opened + 1u8

@[impure]
fn close():
    closed ← closed + 1u8

@[impure]
fn lines(n: u8) ⇉ u8:
    open()
    defer close()
    foreach i := 0u8…n:
        yield i

@[impure]
fn first_over(s: ⇉u8, k: u8) → u8:
    foreach x := s:
        if x > k: return x
    0u8

@[impure]
fn sum(s: ⇉u8) → u8:
    let t: mut u8 = 0u8
    foreach x := s:
        t ← t + x
    t

@[impure]
fn broken(s: ⇉u8) → u8:
    let t: mut u8 = 0u8
    foreach §b x := s:
        if x = 2u8: break §b
        t ← t + x
    t

let std := ⎕import("std")

@[startup, impure]
fn main(init: std.Init) → u6:
    let a := first_over(lines(9u8), 3u8)
    let b := sum(lines(4u8))
    let c := broken(lines(9u8))
    if a = 4u8 ∧ b = 6u8 ∧ c = 1u8 ∧ opened = 3u8 ∧ closed = 3u8: 0u6 else: 1u6
