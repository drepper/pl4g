※ pl4g-test: compile=error diag=4438,4925

※ A function named `each` that answers once is not a walk: the loop is refused, and a
※ note points at the `each` that would have been walked had it been a generator.

let std := ⎕import("std")
type Walk = at : u8 ; last : u8

fn Walk.each(w: Walk, a: &mut arena) → u8:
    w.at

@[startup]
fn main(init: std.Init) → u6:
    let w: Walk = Walk(.at ← 0u8, .last ← 4u8)
    let n: mut u8 = 0u8
    foreach x := w:
        n ← n + x
    if n = 6u8: 0u6 else: 1u6
