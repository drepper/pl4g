※ pl4g-test: compile=ok run=native,qemu exit=0 diag=none

※ What a mask picks, bound to a name with nothing asking for an array, is an
※ iterator: a walk described and not made.  Each walk of it starts from the
※ start, so it may be walked twice; `⇉` written alone takes what it gives from
※ the value, and so does no type at all; another name for it is the same walk;
※ and where an array is asked for -- a name of an array type, `#`, an index --
※ the array is built there, in this call's room.

let std := ⎕import("std")

@[startup, impure]
fn main(init: std.Init) → u6:
    let arr: u8⟦4⟧ = ⟦0u8, 1u8, 2u8, 3u8⟧ in ⎕static
    let q := arr⟦arr > 1⟧
    let n: mut u8 = 0u8
    foreach x := q:
        n ← n + x
    foreach x := q:
        n ← n + x
    ※ `⇉` alone, and another name for the same walk
    let r: ⇉ = arr⟦arr < 2⟧
    let again := r
    foreach i, x := ⎕enumerate(again):
        n ← n + x + (⎕narrow(i, ⌜u8⌝) ?? 0u8)
    ※ an array where one is asked for
    let a: u8⟦⟧ = q
    if n = 12u8 ∧ #q = 2 ∧ a⟦1⟧ = 3u8 ∧ q⟦0⟧ = 2u8: 0u6 else: 1u6
