※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ A view of a table walked a place at a time -- what a mask picks out of it, one
※ copied into another -- is walked in order, row after row, with an index along each
※ dimension carried from one place to the next, so that no turn divides to find
※ where it is.  Where the two runs of a copy overlap, the one written later in
※ memory is copied from its last place back, and the indices run back with it.

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let k: u16 = ⎕narrow(⎕drop(#init.args), ⌜u16⌝) ?? 0u16
    let m: mut u16⟦3, 4⟧ = ⟦⟦k, 2u16, 3u16, 4u16⟧, ⟦5u16, 6u16, 7u16, 8u16⟧,
                            ⟦9u16, 10u16, 11u16, 12u16⟧⟧
    ※ every other column: 1 3 / 5 7 / 9 11
    let block: u16⟦,⟧ = m⟦0…3, 0…4…2⟧
    let some: bool⟦3,2⟧ = ⟦⟦true, false⟧, ⟦false, true⟧, ⟦true, true⟧⟧ in ⎕static
    let seen: mut u16 = 0u16
    foreach x := block⟦some⟧:
        seen ← seen × 16u16 + x
    if seen ≠ 6043u16:
        return 1u6
    ※ copied into a block further on: read from its last place back
    let later: mut u16⟦3, 4⟧ = m
    later⟦1…3, 1…4⟧ ← later⟦0…2, 0…3⟧
    if later⟦1, 1⟧ ≠ 1u16 ∨ later⟦1, 3⟧ ≠ 3u16 ∨ later⟦2, 1⟧ ≠ 5u16 ∨ later⟦2, 3⟧ ≠ 7u16:
        return 2u6
    ※ and into one further back: from its first place on
    let earlier: mut u16⟦3, 4⟧ = m
    earlier⟦0…2, 0…3⟧ ← earlier⟦1…3, 1…4⟧
    if earlier⟦0, 0⟧ ≠ 6u16 ∨ earlier⟦0, 2⟧ ≠ 8u16 ∨ earlier⟦1, 0⟧ ≠ 10u16:
        return 3u6
    if earlier⟦1, 2⟧ = 12u16 ∧ earlier⟦1, 3⟧ = 8u16: 0u6 else: 4u6
