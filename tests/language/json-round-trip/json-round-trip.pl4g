※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ **A document read by `json.decode` and written by `json.encode` is what Python's
※ `json` writes of it**: compact with `separators=(',', ':')`, and pretty with
※ `indent=2`, byte for byte -- every member on a line of its own, two spaces a
※ level, a space after each colon and none after a comma, `[]` and `{}` for an
※ empty array and object.  What each should be was read off Python 3.14 when
※ the test was made.
※
※ **What was written reads back as the same value**: a number with a point stays
※ a `number` -- `1.0` is not the whole number `1`, and is written so -- a whole
※ number stays an `integer`, or a `large` above `i64`, and an object keeps its
※ members in the order they were written, a key written twice among them.
※ `json.equal` says so, kind by kind and all the way down.

unit ¤size → ¤idx

let std := ⎕import("std")
let json := ⎕import("json")

※ Whether `text` decodes, and encodes compactly as `compact` and pretty as
※ `pretty`, and the compact text decodes as the same value again.
fn agrees(text: str, compact: str, pretty: str) → bool:
    let pool: mut arena = ⎕arena
    match json.decode(⎕bytes(text), &mut pool):
        json.Value(v):
            let short: [u8] = json.encode(v, &mut pool) ?? []
            let long: [u8] = json.encode(v, &mut pool, .pretty ← true) ?? []
            if (⎕text(short) ?? "") ≠ compact or (⎕text(long) ?? "") ≠ pretty:
                return false
            match json.decode(short, &mut pool):
                json.Value(again):
                    json.equal(v, again)
                ⊥(_):
                    false
        ⊥(_):
            false

※ What a value is, as a number: which part a `match` takes.
fn kind(v: &json.Value) → u8:
    match v⌖:
        void: 0u8
        bool(_): 1u8
        i64(_): 2u8
        u64(_): 3u8
        f64(_): 4u8
        str(_): 5u8
        [json.Value](_): 6u8
        [json.Member](_): 7u8

※ The kind of each element of an array, as a number in base ten.
fn kinds(text: str) → u64:
    let pool: mut arena = ⎕arena
    match json.decode(⎕bytes(text), &mut pool):
        json.Value(v):
            match v:
                [json.Value](items):
                    let found: mut u64 = 0u64
                    foreach &e: json.Value = items:
                        found ← found × 10u64 + ⎕widen(kind(e), ⌜u64⌝)
                    found
                _:
                    0u64
        ⊥(_):
            0u64

@[startup]
fn main(init: std.Init) → u6:
    ※ every kind of value, white space of every kind around them
    if ¬agrees(" [null , true,false ,\n\t0, -1, 2.5, \"a\", [], {}]\r\n",
               "[null,true,false,0,-1,2.5,\"a\",[],{}]",
               "[\n  null,\n  true,\n  false,\n  0,\n  -1,\n  2.5,\n  \"a\",\n  [],\n  {}\n]"):
        return 1u6
    ※ nested, the members in the order written
    if ¬agrees("{\"z\": {\"y\": [1, {\"x\": []}]}, \"a\": \"\"}",
               "{\"z\":{\"y\":[1,{\"x\":[]}]},\"a\":\"\"}",
               "{\n  \"z\": {\n    \"y\": [\n      1,\n      {\n        \"x\": []\n      }\n    ]\n  },\n  \"a\": \"\"\n}"):
        return 2u6
    ※ a key twice, both kept
    if ¬agrees("{\"k\":1,\"k\":2}", "{\"k\":1,\"k\":2}", "{\n  \"k\": 1,\n  \"k\": 2\n}"):
        return 3u6
    ※ numbers as Python writes them back: a point or an exponent on every one that
    ※ is not whole, the shortest digits, the exponent from 1e16 on and below 1e-4
    if ¬agrees("[1.0, 1e2, 1E400e0, 0.0001, 0.00001, 1e16, 123456789012345678, -0.0, 2.5e-10]",
               "", ""):
        ※ 1E400e0 is no number: refused, as it should be
        if ¬agrees("[1.0, 1e2, 0.0001, 0.00001, 1e15, 1e16, 123456789012345678, -0.0, 2.5e-10]",
                   "[1.0,100.0,0.0001,1e-05,1000000000000000.0,1e+16,123456789012345678,-0.0,2.5e-10]",
                   "[\n  1.0,\n  100.0,\n  0.0001,\n  1e-05,\n  1000000000000000.0,\n  1e+16,\n  123456789012345678,\n  -0.0,\n  2.5e-10\n]"):
            return 4u6
    else:
        return 5u6
    ※ text: the escapes written back as Python writes them, and everything else as
    ※ it is -- a `\u` escape of a character that needs none is that character
    if ¬agrees("[\"\\u0041\\n\\t\\\"\\\\\\/\\b\\f\\r\\u0001\\u001f\\u007f\\u00e9\\u20ac\\ud83d\\ude00\"]",
               "[\"A\\n\\t\\\"\\\\/\\b\\f\\r\\u0001\\u001f\u007fé€😀\"]",
               "[\n  \"A\\n\\t\\\"\\\\/\\b\\f\\r\\u0001\\u001f\u007fé€😀\"\n]"):
        return 6u6
    ※ what kind each number is: integer, large, number
    if kinds("[0, -9223372036854775808, 9223372036854775807, 9223372036854775808, 18446744073709551615, 18446744073709551616, 1.5, 1e0, -0]") ≠ 222334442u64:
        return 7u6
    ※ and the rest
    if kinds("[null, true, \"\", [], {}]") ≠ 1567u64:
        return 8u6
    ※ a document that is one value and nothing else
    if ¬agrees("\"only\"", "\"only\"", "\"only\"") or ¬agrees(" 42 ", "42", "42"):
        return 9u6
    0u6
