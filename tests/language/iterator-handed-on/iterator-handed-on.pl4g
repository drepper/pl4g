※ pl4g-test: compile=ok run=native,qemu exit=0 diag=none

※ A parameter of `⇉T` takes anything a loop walks that gives a `T`: an iterator
※ bound to a name, a pick written in place, an array, a list.  What it walks is
※ described in the caller's room and the callee takes each turn through a call,
※ since it cannot see what it walks -- elements of any size, records and rows
※ included, come back through room the walk keeps for them.

type Person = { age : u8 ; height : u8 }

fn tall(s: ⇉Person) → u8:
    let n: mut u8 = 0u8
    foreach p := s:
        n ← n + p.height - 150u8
    n

fn widths(s: ⇉u8⟦2⟧) → u8:
    let n: mut u8 = 0u8
    foreach r := s:
        n ← n + r⟦1⟧
    n
fn total(s: ⇉u8) → u8:
    let n: mut u8 = 0u8
    foreach x := s:
        n ← n ⊞ x
    n


@[startup, impure]
fn main() → u6:
    let ps: Person⟦3⟧ = ⟦Person(.age ← 12u8, .height ← 170u8), Person(.age ← 30u8, .height ← 180u8), Person(.age ← 40u8, .height ← 160u8)⟧ in ⎕static
    let adults := ps⟦ps¨.age ≥ 18u8⟧
    let m: u8⟦3,2⟧ = ⟦⟦1u8, 2u8⟧, ⟦3u8, 4u8⟧, ⟦5u8, 6u8⟧⟧ in ⎕static
    let rows := m⟦⟦true, false, true⟧⟧
    let n: mut u8 = 0u8
    foreach p := adults:
        n ← n + p.age
    let v: u8⟦4⟧ = ⟦0u8, 1u8, 2u8, 3u8⟧ in ⎕static
    let l: [u8] = [7u8, 8u8] in ⎕static
    let s := total(v⟦v > 1u8⟧) + total(v) + total(l)
    if tall(adults) = 40u8 ∧ widths(rows) = 8u8 ∧ n = 70u8 ∧ tall(ps) = 60u8 ∧ s = 26u8: 0u6 else: 1u6
