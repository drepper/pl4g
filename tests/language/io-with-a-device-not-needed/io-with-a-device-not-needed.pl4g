※ pl4g-test: compile=fail
※ pl4g-test: expect-diag 4933 LANG_MARK_NOT_NEEDED

※ A device handed over is the permission to do input or output through it, so
※ a function holding one needs nothing written to write to it.  `@[io]` on such
※ a function says only what its parameter already says, and is refused.

let std := ⎕import("std")

@[io]
fn greet(to: &mut std.io.Writer) → u64 ¤size ? i32:
    std.Io.print(to, ⎕bytes("hi\n"))

@[startup]
fn main(init: std.Init) → u6:
    if (greet(&mut init.io.output) ?? 0) = 3: 0u6 else: 1u6
