※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ A table keyed by text keeps the order its keys were put in as one keyed by a
※ number does: the order is the dense array's, whatever the keys are -- which
※ is what makes a JSON object read into a table come out in the order it was
※ written.
※
※ What the four operators a set answers come to is in order too, the order
※ Python gives them: the left operand's keys in its order, and then -- for
※ what is in either, and what is in one only -- the right operand's that the
※ left has not, in the right's order.

let std := ⎕import("std")

let names: str⟦6⟧ = ⟦"zeta", "alpha", "mu", "omega", "beta", "kappa"⟧ in ⎕static

@[startup]
fn main(init: std.Init) → u6:
    let d: mut ⸨str: u64⸩ = ⸨⸩
    let put: mut u64 = 0u64
    foreach name := names:
        d⸨name⸩ ← put
        put ← put + 1u64
    d⸨"mu"⸩ ← 20u64
    †d⸨"alpha"⸩
    d⸨"alpha"⸩ ← 10u64
    ※ zeta, mu, omega, beta, kappa, alpha
    let order: str⟦6⟧ = ⟦"zeta", "mu", "omega", "beta", "kappa", "alpha"⟧ in ⎕static
    let values: u64⟦6⟧ = ⟦0u64, 20u64, 3u64, 4u64, 5u64, 10u64⟧ in ⎕static
    let at: mut u64 ¤idx = 0
    let fine: mut bool = true
    foreach k, v := d:
        fine ← fine ∧ k = order⟦at⟧ ∧ v = values⟦at⟧
        at ← at + 1
    if ¬fine ∨ at ≠ 6:
        return 1u6

    let a: ⸨str⸩ = ⸨"one", "two", "three", "four"⸩ in ⎕static
    let b: ⸨str⸩ = ⸨"five", "three", "one", "six"⸩ in ⎕static
    let either: str⟦6⟧ = ⟦"one", "two", "three", "four", "five", "six"⟧ in ⎕static
    at ← 0
    foreach k := a | b:
        fine ← fine ∧ k = either⟦at⟧
        at ← at + 1
    if ¬fine ∨ at ≠ 6:
        return 2u6

    let both: str⟦2⟧ = ⟦"one", "three"⟧ in ⎕static
    at ← 0
    foreach k := a & b:
        fine ← fine ∧ k = both⟦at⟧
        at ← at + 1
    if ¬fine ∨ at ≠ 2:
        return 3u6

    let one_only: str⟦4⟧ = ⟦"two", "four", "five", "six"⟧ in ⎕static
    at ← 0
    foreach k := a ^ b:
        fine ← fine ∧ k = one_only⟦at⟧
        at ← at + 1
    if ¬fine ∨ at ≠ 4:
        return 4u6

    let first_only: str⟦2⟧ = ⟦"five", "six"⟧ in ⎕static
    at ← 0
    foreach k := b - a:
        fine ← fine ∧ k = first_only⟦at⟧
        at ← at + 1
    if ¬fine ∨ at ≠ 2:
        return 5u6
    0u6
