※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ `a ← v` for a name of an array copies what `v` holds into the elements `a`
※ names, and `a` goes on naming them -- so in a loop it is the same place at
※ every turn, as a name with storage of its own is, and not a value the loop
※ carries from one turn to the next.  Carried, it reached the body as the
※ loop's parameter, which nothing could tell was this function's own frame, and
※ a pure function writing its own array was refused for writing memory it did
※ not make (4479).

let std := ⎕import("std")

unit ¤size → ¤idx

fn sum_of_blocks(bytes: u8⟦⟧) → u64:
    let block: mut u8⟦4⟧ = ⟦0u8, 0u8, 0u8, 0u8⟧
    let sum: mut u64 = 0u64
    let at: mut u64 ¤idx = 0
    let n: u64 ¤idx = #bytes
    while at + 4 ≤ n:
        block ← bytes⟦at…at + 4⟧
        at ← at + 4
        sum ← sum + ⎕widen(block⟦0⟧, ⌜u64⌝) + ⎕widen(block⟦3⟧, ⌜u64⌝)
    sum

@[startup]
fn main(init: std.Init) → u6:
    ※ a + d and e + h: 97 + 100 and 101 + 104.
    if sum_of_blocks(⎕bytes("abcdefgh")) ≠ 402u64:
        return 1u6
    ※ Assigned inside a nested loop and an `if`, read after both.
    let row: mut u8⟦2⟧ = ⟦0u8, 0u8⟧
    let total: mut u64 = 0u64
    foreach i: u8 = 0u8…3u8:
        foreach j: u8 = 0u8…2u8:
            if j = 1u8:
                row ← ⟦i, j⟧
        total ← total + ⎕widen(row⟦0⟧, ⌜u64⌝)
    if total ≠ 3u64 ∨ row⟦0⟧ ≠ 2u8:
        return 2u6
    0u6
