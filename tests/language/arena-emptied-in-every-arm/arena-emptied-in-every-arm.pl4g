※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ An arena is given back on every way out of the block it was defined in: here by the `return`
※ in one arm and at the end of the function after the other, each after what it answers was
※ worked out.

fn both(c: bool) → bool:
    let s: mut arena = ⎕arena
    let t: str = "a" ⧺ "b" in s
    if c:
        return t = "ab"
    #t = 2
let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    if both(true): 0u6 else: 1u6
