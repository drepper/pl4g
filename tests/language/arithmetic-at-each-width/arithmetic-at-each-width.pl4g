※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ A sum or a difference of a narrow type is computed at that type's own width,
※ on the architectures whose instructions have one, and what says whether it
※ went past is the flags the instruction wrote.  Each of these lands exactly on
※ an end of its type, which is the answer such a computation is most likely to
※ get wrong: one more or one less either way and it would have gone past.

fn adds(a: u8, b: u8) → u8:
    a + b

fn subs(a: i8, b: i8) → i8:
    a - b

fn addw(a: u16, b: u16) → u16:
    a + b

fn subw(a: i16, b: i16) → i16:
    a - b

fn addl(a: i32, b: i32) → i32:
    a + b

fn subl(a: u32, b: u32) → u32:
    a - b

fn addq(a: i64, b: i64) → i64:
    a + b

fn subq(a: u64, b: u64) → u64:
    a - b

@[startup]
fn main() → u6:
    if adds(200u8, 55u8) ≠ 255u8:
        1u6
    elif subs(⁻100i8, 28i8) ≠ ⁻128i8:
        2u6
    elif addw(60000u16, 5535u16) ≠ 65535u16:
        3u6
    elif subw(⁻30000i16, 2768i16) ≠ ⁻32768i16:
        4u6
    elif addl(2000000000i32, 147483647i32) ≠ 2147483647i32:
        5u6
    elif subl(10u32, 10u32) ≠ 0u32:
        6u6
    elif addq(9000000000000000000i64, 223372036854775807i64) ≠ 9223372036854775807i64:
        7u6
    elif subq(18000000000000000000u64, 18000000000000000000u64) ≠ 0u64:
        8u6
    else:
        0u6
