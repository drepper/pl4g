※ pl4g-test: compile=error diag=4687
※ pl4g-test: expect-diag 4687 LANG_CLOSABLE_STORED

※ Put inside a tuple, a value that must be closed is in nothing whose scope
※ ends, so nothing would ask whether it was.

@[closed_by(close)]
type Handle = n : u8

fn Handle.close(h: Handle):
    let n: u8 = h.n

fn made(n: u8) → Handle:
    Handle(.n ← n)

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let h: Handle = made(1u8)
    let pair := 〈h, 2u8〉
    0u6
