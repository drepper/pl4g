※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ Adding and subtracting over a whole run, with the check that says whether any
※ element went past the end of its type.  A machine that does the arithmetic to
※ a whole register at once has no flags to read -- it does not write sixteen
※ carry flags for sixteen additions -- so the question is asked of the answer,
※ of every lane at the same time, and it has to come to what asking each
※ element on its own would come to.  Both signs and every lane width are here,
※ because the four questions are four different formulas.

let u: u8⟦16⟧ = ⟦1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8⟧
let i: i8⟦16⟧ = ⟦1i8, 2i8, 3i8, 4i8, 5i8, 6i8, 7i8, 8i8, 9i8, 10i8, 11i8, 12i8, 13i8, 14i8, 15i8, 16i8⟧

@[startup]
fn main() → u6:
    let up: u8⟦16⟧ = u + 200u8
    let down: u8⟦16⟧ = u - 1u8
    let si: i8⟦16⟧ = i + 100i8
    let sd: i8⟦16⟧ = i - 100i8
    ※ The saturating pair, which stops at the end of the type instead.
    let held: u8⟦16⟧ = u ⊞ 250u8
    let floored: u8⟦16⟧ = u ⊟ 20u8
    ※ Wider lanes, which have no saturating instruction and no narrow one.
    let w: u32⟦4⟧ = ⟦1u32, 2u32, 3u32, 4u32⟧
    let wide: u32⟦4⟧ = w + 4000000000u32
    let q: i64⟦2⟧ = ⟦1i64, ⁻2i64⟧
    let quad: i64⟦2⟧ = q - 1i64
    if up⟦0⟧ ≠ 201u8 ∨ up⟦15⟧ ≠ 216u8:
        1u6
    elif down⟦0⟧ ≠ 0u8 ∨ down⟦15⟧ ≠ 15u8:
        2u6
    elif si⟦0⟧ ≠ 101i8 ∨ si⟦15⟧ ≠ 116i8:
        3u6
    elif sd⟦0⟧ ≠ ⁻99i8 ∨ sd⟦15⟧ ≠ ⁻84i8:
        4u6
    elif held⟦0⟧ ≠ 251u8 ∨ held⟦15⟧ ≠ 255u8:
        5u6
    elif floored⟦0⟧ ≠ 0u8 ∨ floored⟦15⟧ ≠ 0u8:
        6u6
    elif wide⟦0⟧ ≠ 4000000001u32 ∨ wide⟦3⟧ ≠ 4000000004u32:
        7u6
    elif quad⟦0⟧ ≠ 0i64 ∨ quad⟦1⟧ ≠ ⁻3i64:
        8u6
    else:
        0u6
