※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ **`⎕kindof(⌜T⌝)` names what kind of type `T` is**, as text the compiler settles and
※ compares with a literal in a `comptime if`: one question answering which kind, rather
※ than a predicate for each, so that a generic definition says a different thing for a
※ list than for a sum in one chain of arms.  **`⎕alternatives(v)` takes a sum apart** as
※ `⎕fields` takes a record: a tuple of pairs, each a part's name and a view of what it
※ carries -- one element where the sum holds that part, none where it does not, so a
※ part it does not hold is never read.  A part that carries nothing is a view of the
※ `true` it is made with.
※
※ Compare **Zig**'s `@typeInfo`, a union with a case for each kind and, for a tagged
※ union, its fields, walked with `inline for` and asked which is active with
※ `std.meta.activeTag`; **C++26**'s `is_union_type` and friends, a predicate each;
※ **Rust**, which has neither and derives what it needs with a macro.

let std := ⎕import("std")

type Shape = none : void | circle : u32 | label : str
type Point = x : u8 ; y : u8

fn kind(v: T') → str:
    comptime if ⎕kindof(⌜T'⌝) = "list":
        "list"
    comptime elif ⎕kindof(⌜T'⌝) = "dictionary":
        "dictionary"
    comptime elif ⎕kindof(⌜T'⌝) = "set":
        "set"
    comptime elif ⎕kindof(⌜T'⌝) = "sum":
        "sum"
    comptime elif "record" = ⎕kindof(⌜T'⌝):
        "record"
    comptime elif ⎕kindof(⌜T'⌝) ≠ "integer":
        "something"
    else:
        "integer"

※ How many parts a sum holds, a hundred for each, and how long the text of what it
※ carries is: the views of the parts it does not hold are empty.
fn held(v: T') → u64:
    let found: mut u64 = 0u64
    comptime foreach p := ⎕alternatives(v):
        if #p⟦1⟧ ≠ 0:
            found ← found + 100u64 + ⎕drop(#(⍕p⟦1⟧⟦0⟧))
    found

@[startup]
fn main(init: std.Init) → u6:
    let l: [u8] = [1u8] in ⎕static
    let d: ⸨u8: u8⸩ = ⸨1u8: 2u8⸩ in ⎕static
    let s: ⸨u8⸩ = ⸨1u8⸩ in ⎕static
    if kind(l) ≠ "list" ∨ kind(d) ≠ "dictionary" ∨ kind(s) ≠ "set" ∨ kind(7u8) ≠ "integer":
        return 1u6
    if kind(Shape(.circle ← 3u32)) ≠ "sum" ∨ kind(Point(.x ← 1u8, .y ← 2u8)) ≠ "record":
        return 2u6
    if kind("text") ≠ "something" ∨ kind(true) ≠ "something":
        return 3u6
    if held(Shape(.circle ← 37u32)) ≠ 102u64 ∨ held(Shape(.none ← true)) ≠ 104u64:
        return 4u6
    if held(Shape(.label ← "xyz")) ≠ 103u64: 5u6 else: 0u6
