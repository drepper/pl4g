※ pl4g-test: compile=error diag=4927

※ A computed step over `u8` is a `u8` or an `i8`, and nothing wider: nothing is widened
※ on the way into a range.

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let by: u16 = 2u16
    let n: mut u8 = 0u8
    foreach i := 0u8…5u8…by:
        n ← n + i
    if n = 6u8: 0u6 else: 1u6
