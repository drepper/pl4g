※ pl4g-test: compile=error diag=4681
※ pl4g-test: expect-diag 4681 LANG_CLOSABLE_NOT_CLOSED

※ A variable holding a value whose type says `@[closed_by(close)]` closes it or
※ moves it on along every way out of its scope.  Here one way does neither.

@[closed_by(close)]
type Handle = n : u8

fn Handle.close(h: Handle):
    let n: u8 = h.n

fn made(n: u8) → Handle:
    Handle(.n ← n)

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let h: Handle = made(1u8)
    if h.n = 1u8:
        Handle.close(h)
        return 0u6
    1u6
