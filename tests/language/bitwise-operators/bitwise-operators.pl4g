※ pl4g-test: compile=ok opt=0,1
※ pl4g-test: run=native,qemu exit=0
※ pl4g-test: diag=none

※ The four bitwise operators, on values the compiler cannot fold away, so that
※ each one is really generated and really run.
let mask: u8 = 0b1100_0011u8

let bits: u8 = 0b0101_0101u8

@[startup]
fn main() → u6:
    ※ what this used to say through the exit status, which is six bits now
    if (mask & bits) | (~mask ^ bits) ≠ 105u8:
        1u6
    else:
        0u6
