※ A type parameter is written with the mark after it, in the list as everywhere
※ else -- which keeps a type named in the definition from being taken for one.

type Pair(t) = first: t ; second: t

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    0u6
