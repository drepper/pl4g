※ pl4g-test: compile=ok run=native,qemu exit=42 diag=none

※ Several arguments, taken in the order they are written.  Subtraction is not
※ symmetric, so the order is visible in the answer.

fn difference(a: u6, b: u6) → u6:
    a ⊟ b

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    difference(50u6, 8u6)
