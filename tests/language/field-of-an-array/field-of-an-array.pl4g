※ pl4g-test: compile=error diag=4662
※ pl4g-test: expect-diag 4662 LANG_FIELD_OF_AN_ARRAY

※ An array has no fields of its own.  What each element has is read through
※ '¨', and the message says so.

type Person = { age : u8 ; height : u8 }

fn add(a: u8, b: u8) → u8:
    a + b

let std := ⎕import("std")

@[startup, impure]
fn main(init: std.Init) → u6:
    let ps: Person⟦1⟧ = ⟦Person(.age ← 1u8, .height ← 2u8)⟧ in ⎕static
    let a: u8⟦1⟧ = ps.age
    0u6
