type Person = { age : u8 ; height : u8 }

fn add(a: u8, b: u8) → u8:
    a + b

@[startup, impure]
fn main() → u6:
    let ps: Person⟦1⟧ = ⟦Person(.age ← 1u8, .height ← 2u8)⟧ in ⎕static
    let a: u8⟦1⟧ = ps.age
    0u6
