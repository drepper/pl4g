※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ An element whose allocator does not last as long as its container is copied into the
※ container's, and a record holding text is copied field by field: what `b` held is in `a`
※ before `b` is given back.  Text in the image would have gone in as it is.

type R = f: str

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let a: mut arena = ⎕arena
    defer ⎕empty(a)
    let b: mut arena = ⎕arena
    defer ⎕empty(b)
    let l: [R] = [R(.f ← "x" ⧺ "y" in b)] in a
    if #l = 1: 0u6 else: 1u6
