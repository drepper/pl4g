※ pl4g-test: compile=ok opt=0,1
※ pl4g-test: run=native,qemu exit=0
※ pl4g-test: diag=none

※ `⎕mask(b)` is a run of truth values as the bits of a whole number, the
※ first of them the lowest bit, in the narrowest of `u8`, `u16`, `u32` and `u64`
※ that has a bit for each.  What it is handed is nearly always a comparison
※ walked over a run of bytes, which a machine with registers of them asks of
※ sixteen or thirty-two bytes at once and gathers into one ordinary register --
※ and a machine without asks a byte at a time.  Every answer here is held to the
※ same answer worked out one element at a time, by a loop that asks each
※ element on its own and so cannot share a mistake with what it checks.
※
※ Here, every comparison, both ways round, of unsigned and signed bytes against
※ the values where an order changes its mind; two runs compared lane by lane;
※ and a run copied out of a view at every alignment.  The rest is in
※ `mask-of-a-run`.

let std := ⎕import("std")

※ Whether *x* and *v* stand in the order numbered *op*, asked of one pair.
fn holds(x: u8, v: u8, op: u8) → bool:
    if op = 0u8:
        x = v
    elif op = 1u8:
        x ≠ v
    elif op = 2u8:
        x < v
    elif op = 3u8:
        x ≤ v
    elif op = 4u8:
        x > v
    else:
        x ≥ v

fn holds_signed(x: i8, v: i8, op: u8) → bool:
    if op = 0u8:
        x = v
    elif op = 1u8:
        x ≠ v
    elif op = 2u8:
        x < v
    elif op = 3u8:
        x ≤ v
    elif op = 4u8:
        x > v
    else:
        x ≥ v

※ The mask of the order numbered *op* between each element of *d* and *v*,
※ worked out an element at a time.
fn ordered(d: u8⟦⟧, v: u8, op: u8) → u64:
    let found: mut u64 = 0u64
    foreach i, x := ⎕enumerate(d):
        if holds(x, v, op):
            found ← found | (1u64 « i)
    found

※ The same with *v* on the left.
fn ordered_from(v: u8, d: u8⟦⟧, op: u8) → u64:
    let found: mut u64 = 0u64
    foreach i, x := ⎕enumerate(d):
        if holds(v, x, op):
            found ← found | (1u64 « i)
    found

fn ordered_signed(d: i8⟦⟧, v: i8, op: u8) → u64:
    let found: mut u64 = 0u64
    foreach i, x := ⎕enumerate(d):
        if holds_signed(x, v, op):
            found ← found | (1u64 « i)
    found

※ The mask of the order numbered *op* between two runs, lane by lane.
fn paired(d: u8⟦⟧, e: u8⟦⟧, op: u8) → u64:
    let found: mut u64 = 0u64
    foreach i, x := ⎕enumerate(d):
        if holds(x, e⟦⎕unit(i, ⌜idx⌝)⟧, op):
            found ← found | (1u64 « i)
    found

※ Every comparison of unsigned bytes, both ways round, against the four values
※ where an unsigned order and a signed one part: nought, the largest a signed
※ byte holds, the one after it, and the largest an unsigned one does.
fn unsigned_orders() → u6:
    let d: u8⟦64⟧ = ⟦0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8, 0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8, 0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8, 0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8⟧ in ⎕static
    let edges: u8⟦4⟧ = ⟦0u8, 127u8, 128u8, 255u8⟧ in ⎕static
    let wrong: mut u6 = 0u6
    foreach _, v := ⎕enumerate(edges):
        if ⎕mask(d = v) ≠ ordered(d, v, 0u8):
            wrong ← 12u6
        if ⎕mask(d ≠ v) ≠ ordered(d, v, 1u8):
            wrong ← 13u6
        if ⎕mask(d < v) ≠ ordered(d, v, 2u8):
            wrong ← 14u6
        if ⎕mask(d ≤ v) ≠ ordered(d, v, 3u8):
            wrong ← 15u6
        if ⎕mask(d > v) ≠ ordered(d, v, 4u8):
            wrong ← 16u6
        if ⎕mask(d ≥ v) ≠ ordered(d, v, 5u8):
            wrong ← 17u6
        if ⎕mask(v < d) ≠ ordered_from(v, d, 2u8):
            wrong ← 18u6
        if ⎕mask(v ≤ d) ≠ ordered_from(v, d, 3u8):
            wrong ← 19u6
        if ⎕mask(v > d) ≠ ordered_from(v, d, 4u8):
            wrong ← 20u6
        if ⎕mask(v ≥ d) ≠ ordered_from(v, d, 5u8):
            wrong ← 21u6
    wrong

※ The same of signed bytes, whose edges are the smallest, minus one, nought and
※ the largest.
fn signed_orders() → u6:
    let d: i8⟦64⟧ = ⟦0i8, ⁻1i8, ⁻56i8, ⁻127i8, 13i8, 127i8, 32i8, 1i8, 34i8, 7i8, ⁻2i8, 9i8, ⁻128i8, 10i8, 126i8, 92i8, 0i8, ⁻1i8, ⁻56i8, ⁻127i8, 13i8, 127i8, 32i8, 1i8, 34i8, 7i8, ⁻2i8, 9i8, ⁻128i8, 10i8, 126i8, 92i8, 0i8, ⁻1i8, ⁻56i8, ⁻127i8, 13i8, 127i8, 32i8, 1i8, 34i8, 7i8, ⁻2i8, 9i8, ⁻128i8, 10i8, 126i8, 92i8, 0i8, ⁻1i8, ⁻56i8, ⁻127i8, 13i8, 127i8, 32i8, 1i8, 34i8, 7i8, ⁻2i8, 9i8, ⁻128i8, 10i8, 126i8, 92i8⟧ in ⎕static
    let edges: i8⟦4⟧ = ⟦⁻128i8, ⁻1i8, 0i8, 127i8⟧ in ⎕static
    let wrong: mut u6 = 0u6
    foreach _, v := ⎕enumerate(edges):
        if ⎕mask(d = v) ≠ ordered_signed(d, v, 0u8):
            wrong ← 22u6
        if ⎕mask(d ≠ v) ≠ ordered_signed(d, v, 1u8):
            wrong ← 23u6
        if ⎕mask(d < v) ≠ ordered_signed(d, v, 2u8):
            wrong ← 24u6
        if ⎕mask(d ≤ v) ≠ ordered_signed(d, v, 3u8):
            wrong ← 25u6
        if ⎕mask(d > v) ≠ ordered_signed(d, v, 4u8):
            wrong ← 26u6
        if ⎕mask(d ≥ v) ≠ ordered_signed(d, v, 5u8):
            wrong ← 27u6
    wrong

※ Two runs compared with each other, lane by lane.
fn runs_against_runs() → u6:
    let d: u8⟦64⟧ = ⟦0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8, 0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8, 0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8, 0u8, 255u8, 200u8, 129u8, 13u8, 127u8, 32u8, 1u8, 34u8, 7u8, 254u8, 9u8, 128u8, 10u8, 126u8, 92u8⟧ in ⎕static
    let e: u8⟦64⟧ = ⟦129u8, 34u8, 10u8, 200u8, 1u8, 128u8, 255u8, 32u8, 9u8, 0u8, 127u8, 254u8, 92u8, 13u8, 7u8, 126u8, 129u8, 34u8, 10u8, 200u8, 1u8, 128u8, 255u8, 32u8, 9u8, 0u8, 127u8, 254u8, 92u8, 13u8, 7u8, 126u8, 129u8, 34u8, 10u8, 200u8, 1u8, 128u8, 255u8, 32u8, 9u8, 0u8, 127u8, 254u8, 92u8, 13u8, 7u8, 126u8, 129u8, 34u8, 10u8, 200u8, 1u8, 128u8, 255u8, 32u8, 9u8, 0u8, 127u8, 254u8, 92u8, 13u8, 7u8, 126u8⟧ in ⎕static
    let wrong: mut u6 = 0u6
    if ⎕mask(d = e) ≠ paired(d, e, 0u8):
        wrong ← 28u6
    if ⎕mask(d ≠ e) ≠ paired(d, e, 1u8):
        wrong ← 29u6
    if ⎕mask(d < e) ≠ paired(d, e, 2u8):
        wrong ← 30u6
    if ⎕mask(d ≤ e) ≠ paired(d, e, 3u8):
        wrong ← 31u6
    if ⎕mask(d > e) ≠ paired(d, e, 4u8):
        wrong ← 32u6
    if ⎕mask(d ≥ e) ≠ paired(d, e, 5u8):
        wrong ← 33u6
    wrong

※ A run copied out of a view, at every place it can start in a block of a
※ register's width and a little more: thirty-two bytes and sixty-four, read
※ wherever they happen to be.
fn alignments() → u6:
    let b: u8⟦128⟧ = 128 ⍴ ⟦34u8, 1u8, 92u8, 34u8, 0u8, 34u8, 7u8⟧
    let wrong: mut u6 = 0u6
    let first: u64 ¤idx = 0
    foreach at := first…64:
        let chunk: u8⟦32⟧ = b⟦at…at + 32⟧
        if ⎕widen(⎕mask(chunk = 34u8), ⌜u64⌝) ≠ ordered(b⟦at…at + 32⟧, 34u8, 0u8):
            wrong ← 34u6
        let block: u8⟦64⟧ = b⟦at…at + 64⟧
        if ⎕mask(block < 8u8) ≠ ordered(b⟦at…at + 64⟧, 8u8, 2u8):
            wrong ← 35u6
    wrong

@[startup]
fn main(init: std.Init) → u6:
    let found: u6⟦5⟧ = ⟦unsigned_orders(), signed_orders(), runs_against_runs(), alignments(), 0u6⟧
    let wrong: mut u6 = 0u6
    foreach _, one := ⎕enumerate(found):
        if wrong = 0u6:
            wrong ← one
    wrong
