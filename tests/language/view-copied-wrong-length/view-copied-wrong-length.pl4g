※ pl4g-test: compile=ok run=native,qemu exit=82 diag=none

※ Where how many elements a view holds is known only while running, it is
※ compared with what the name's type states before anything is copied, and a
※ difference stops the program as an index outside its array does: three
※ elements are given to a name of four.

fn taken(input: u8⟦⟧, n: u64 ¤idx) → u8:
    let chunk: u8⟦4⟧ = input⟦0…n⟧
    chunk⟦0⟧

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let b: u8⟦8⟧ = ⟦1u8, 2u8, 4u8, 8u8, 16u8, 32u8, 64u8, 128u8⟧ in ⎕static
    if taken(b, 3) = 1u8: 0u6 else: 1u6
