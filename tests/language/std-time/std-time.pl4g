※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ `std.time` is POSIX's `clock_gettime` and `clock_getres`: a `Clock` to read,
※ answering a `Timespec` or the system's error number.  A compiled program reads
※ the clocks through the kernel's vDSO, which a constructor of the module finds
※ through the auxiliary vector before the program starts, and the kernel itself
※ where there is none.
※
※ A `Timespec` is laid out as C's is: answered by value, as C answers one, and
※ handed to a call as a reference, which is how the helpers below take one.
※
※ Compare: **C**'s `clock_gettime` itself, which this is but for writing the
※ time into a place the caller hands it; **Rust**'s `std::time::Instant` and
※ `SystemTime`, and **Go**'s `time.Now`, which wrap the same call in a value of
※ their own; **Python**'s `time.clock_gettime`, which takes the same clock
※ numbers.

let std := ⎕import("std")

※ Whether `t` is a time a clock can say: nanoseconds below a second.
fn well_formed(t: &std.time.Timespec) → bool:
    t⌖.tv_sec ≥ 0i64 ∧ t⌖.tv_nsec ≥ 0i64 ∧ t⌖.tv_nsec < 1000000000i64

※ Whether `later` is not before `earlier`.
fn not_before(later: &std.time.Timespec, earlier: &std.time.Timespec) → bool:
    later⌖.tv_sec > earlier⌖.tv_sec ∨ (later⌖.tv_sec = earlier⌖.tv_sec ∧ later⌖.tv_nsec ≥ earlier⌖.tv_nsec)

※ The time `clock` says, or nought where it cannot be read.
@[impure]
fn now(clock: std.time.Clock) → std.time.Timespec:
    std.time.clock_gettime(clock) ?? std.time.Timespec(.tv_sec ← ⁻1i64, .tv_nsec ← ⁻1i64)

※ Whether `clock` can be read and asked for its resolution, and says a time.
@[impure]
fn readable(clock: std.time.Clock) → bool:
    match std.time.clock_getres(clock):
        std.time.Timespec(r):
            let t: std.time.Timespec = now(clock)
            well_formed(&t) ∧ well_formed(&r) ∧ r.tv_sec = 0i64 ∧ r.tv_nsec > 0i64
        ⊥(_):
            false

※ Some work to spend processor time on.
@[opaque]
fn spin(n: u64) → u64:
    let s: mut u64 = 0u64
    foreach i := 0u64…n:
        s ← ⎕wrap(s × 31u64 + i)
    s

@[startup, impure]
fn main(init: std.Init) → u6:
    let wall: std.time.Timespec = now(std.time.Clock.realtime)
    ※ after the start of 2024
    if wall.tv_sec < 1704067200i64 ∨ ¬well_formed(&wall):
        return 2u6
    let first: std.time.Timespec = now(std.time.Clock.monotonic)
    let second: std.time.Timespec = now(std.time.Clock.monotonic)
    if ¬well_formed(&first) ∨ ¬not_before(&second, &first):
        return 5u6
    if (¬readable(std.time.Clock.realtime) ∨ ¬readable(std.time.Clock.monotonic)
            ∨ ¬readable(std.time.Clock.process_cputime) ∨ ¬readable(std.time.Clock.thread_cputime)
            ∨ ¬readable(std.time.Clock.monotonic_raw) ∨ ¬readable(std.time.Clock.boottime)):
        return 6u6
    ※ the coarse clocks and TAI are read, but their resolution may be a tick
    let fine: std.time.Timespec = now(std.time.Clock.realtime_coarse)
    let coarse: std.time.Timespec = now(std.time.Clock.monotonic_coarse)
    let tai: std.time.Timespec = now(std.time.Clock.tai)
    if ¬well_formed(&fine) ∨ ¬well_formed(&coarse) ∨ ¬well_formed(&tai):
        return 7u6
    ※ the processor time of the process grows with work done
    let before: std.time.Timespec = now(std.time.Clock.process_cputime)
    let spent: u64 = spin(20000000u64)
    let after: std.time.Timespec = now(std.time.Clock.process_cputime)
    if ¬not_before(&after, &before) ∨ (after.tv_sec = before.tv_sec ∧ after.tv_nsec = before.tv_nsec) ∨ spent = 0u64:
        return 10u6
    0u6
