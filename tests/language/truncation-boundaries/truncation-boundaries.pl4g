※ pl4g-test: compile=ok opt=0,1
※ pl4g-test: run=native,qemu exit=0
※ pl4g-test: diag=none

※ The largest value of each type is accepted; one more would not be.
let byte_max: u8 = 255u8
let half_max: u16 = 65535u16
let word_max: u32 = 4294967295u32
let wide_max: u64 = 18446744073709551615u64
let signed_byte_max: i8 = 127i8
let signed_wide_max: i64 = 9223372036854775807i64

@[startup]
fn main() → u6:
    ※ what this used to say through the exit status, which is six bits now
    if byte_max ≠ 255u8:
        1u6
    else:
        0u6
