※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ `⎕heap` is the arena the compiler provides, and **taking room from it is no effect**: what is
※ made there is new, nothing else can reach it, and it lasts as long as the program.  So a pure
※ function may allocate there, named with `in ⎕heap` or not named at all, and may answer what it
※ made -- which is how a function hands a caller text when the caller gave it no arena.
※
※ What stays impure is what a call could not undo by itself: writing a variable at the top
※ level, writing memory somebody else made, and `⎕empty` of an arena that is not its own.

let std := ⎕import("std")

fn arrow(first: str) → str:
    let second := "<-"
    first ⧺ second in ⎕heap

fn unnamed(first: str) → str:
    first ⧺ "!"

fn shown(v: u16) → str:
    ⍕v

fn shown_in(v: u16) → str:
    ⍕v in ⎕heap

fn kept() → ⸨u8⸩:
    ⸨1u8, 2u8⸩

fn formatted(v: u16) → str:
    std.format⌜"<{}>", v⌝

@[startup]
fn main() → u6:
    if arrow("a") ≠ "a<-":
        return 1u6
    if unnamed("a") ≠ "a!":
        return 2u6
    if shown(42u16) ≠ "42" ∨ shown_in(7u16) ≠ "7":
        return 3u6
    if ¬kept()⸨2u8⸩:
        return 4u6
    if formatted(9u16) ≠ "<9>":
        return 5u6
    0u6
