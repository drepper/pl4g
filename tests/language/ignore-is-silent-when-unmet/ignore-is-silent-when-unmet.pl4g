※ pl4g-test: compile=ok
※ pl4g-test: run=native exit=5
※ pl4g-test: diag=none

※ Where the diagnostic does not arise, 'ignore' says nothing -- which is the
※ whole difference between it and 'expect'.
let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    @[ignore(4006)]
    let a: u6 = 5u6
    a
