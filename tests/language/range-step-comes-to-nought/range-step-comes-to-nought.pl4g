※ pl4g-test: compile=ok run=native,qemu exit=91 diag=none

※ A step worked out to be nought would never end, and stops the program with a status
※ of its own -- the way Python's `range` raises for one.  Written down, it is refused
※ while compiling instead (4442).

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let by: u8 = ⎕narrow(⎕drop(#init.args) - 1u64, ⌜u8⌝) ?? 1u8
    let n: mut u8 = 0u8
    foreach i := 0u8…5u8…by:
        n ← n + i
    if n = 10u8: 0u6 else: 1u6
