※ pl4g-test: compile=error
※ pl4g-test: expect-diag 4619 LANG_MADE_IN_ANSWER_ELSEWHERE

※ `→ T in a` promises every caller that the answer was made in what `a` names, so an answer
※ made in another arena the call was handed breaks the promise: the caller may give that one
※ back and keep the answer.

let std := ⎕import("std")

fn label(a: &mut arena, b: &mut arena, v: u16) → str in a:
    ⍕v in b

@[startup]
fn main() → u6:
    let x: mut arena = ⎕arena
    defer ⎕empty(x)
    let y: mut arena = ⎕arena
    defer ⎕empty(y)
    if label(&mut x, &mut y, 1u16) = "1": 0u6 else: 1u6
