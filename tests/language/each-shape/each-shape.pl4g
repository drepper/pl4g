※ pl4g-test: compile=error diag=4926

※ A type's `each` takes what is walked and the arena the walk is made in, which the
※ loop hands it -- one shape for every `each`, used or not, so a loop always knows
※ how to call it.  One taking only the value is refused where it is defined.

let std := ⎕import("std")
type Walk = at : u8 ; last : u8

fn Walk.each(w: Walk) ⇉ u8:
    foreach i := w.at…w.last:
        yield i

@[startup]
fn main(init: std.Init) → u6:
    let w: Walk = Walk(.at ← 0u8, .last ← 4u8)
    let n: mut u8 = 0u8
    foreach x := w:
        n ← n + x
    if n = 6u8: 0u6 else: 1u6
