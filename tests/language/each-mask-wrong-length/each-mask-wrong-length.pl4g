※ pl4g-test: compile=ok run=native,qemu exit=82 diag=none

※ A mask worked out a place at a time is as long as the array it picks from.
※ Where the types do not both say so, the two are compared before the loop,
※ and a mask of another length stops the program.

fn picked(v: u8⟦⟧, w: u8⟦⟧) → u8:
    let n: mut u8 = 0u8
    foreach x := v⟦w > 0u8⟧:
        n ← n + x
    n

@[startup, impure]
fn main() → u6:
    let v: u8⟦4⟧ = ⟦10u8, 20u8, 30u8, 40u8⟧ in ⎕static
    let w: u8⟦3⟧ = ⟦1u8, 1u8, 1u8⟧ in ⎕static
    if picked(v, w) = 0u8: 0u6 else: 1u6
