※ pl4g-test: compile=ok opt=0,1
※ pl4g-test: run=native,qemu exit=5
※ pl4g-test: diag=none

※ Reading a variable that lives in memory, and binding the result to one that
※ does not.
let stored: u6 = 5u6

let std := ⎕import("std")

@[startup]
fn main(init: std.Init) → u6:
    let status: u6 = stored
    status
