※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ `v in a` over a value of a type with an `each` is `T.each(v) in a`: the walk's frame
※ is kept in `a`, as for a generator's call written out -- in a loop, handed to a
※ `⇉u8` parameter, and started in `⎕heap` so that the walk may go wherever a value may.

let std := ⎕import("std")
type Walk = at : u8 ; last : u8

fn Walk.each(w: Walk, a: &mut arena) ⇉ u8:
    foreach i := w.at…w.last:
        yield i

fn total(s: ⇉u8) → u8:
    let t: mut u8 = 0u8
    foreach x := s:
        t ← t + x
    t

@[startup]
fn main(init: std.Init) → u6:
    let pool: mut arena = ⎕arena
    let w: Walk = Walk(.at ← 0u8, .last ← 4u8)
    let n: mut u8 = 0u8
    foreach x := w in pool:
        n ← n + x
    let c := ⎕start(w in ⎕heap)
    n ← n + (⎕resume(c) ?? 0u8) + (⎕resume(c) ?? 0u8)
    if total(w in pool) = 6u8 ∧ n = 7u8: 0u6 else: 1u6
