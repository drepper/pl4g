※ pl4g-test: compile=ok run=native,qemu exit=0 diag=none

※ A generator may take type parameters, and is compiled once per set of types a
※ call gives it -- written into the loop that walks it with the types bound
※ there, or walked through calls.  One exported from another file is called
※ through that file's name; its body means what it means in its own file, so
※ it is walked through calls.

let lib := ⎕import("lib")

fn twice(x: T') ⇉ T':
    yield x
    yield x

fn sum(s: ⇉u8) → u8:
    let t: mut u8 = 0u8
    foreach x := s:
        t ← t ⊞ x
    t

fn count(s: ⇉T') → u64:
    let n: mut u64 = 0u64
    foreach _ := s:
        n ← n + 1u64
    n

@[startup, impure]
fn main() → u6:
    let a: mut u8 = 0u8
    foreach x := twice(3u8):
        a ← a + x
    let w: mut u16 = 0u16
    foreach y := twice(1000u16):
        w ← w + y
    let b: mut u8 = 0u8
    foreach x := lib.upto(4u8):
        b ← b + x
    let c := sum(lib.upto(5u8)) + sum(twice(2u8)) + sum(lib.repeat(7u8, 2u8))
    let d := count(lib.repeat("x", 3u8)) + count(twice(1u64))
    if a = 6u8 ∧ w = 2000u16 ∧ b = 6u8 ∧ c = 28u8 ∧ d = 5u64: 0u6 else: 1u6
