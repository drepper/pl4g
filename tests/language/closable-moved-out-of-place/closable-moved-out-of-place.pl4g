※ The standard streams are fields of `std.Init`, and nothing is moved out of a
※ field: they are handed along by reference.

let std := ⎕import("std")

@[startup, impure]
fn main(init: std.Init) → u6:
    let mine: std.fs.Writer = init.io.error
    std.fs.Writer.close(mine)
    0u6
