※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ **An array of a list's elements is joined onto it**: `l ⧺← a` with `a` a view, a slice of
※ one, or an array whose type says its shape, of one dimension -- and `l ⧺ a` and `a ⧺ l`
※ make a new list of the two.  The list grows once, to fit, and the elements go in as **one
※ move of their bytes** where they are one run, which is what a list's own and every array
※ whose type says its shape are; a view whose elements are a step apart is copied an element
※ at a time.  A slice of the list itself may be joined onto it: the room it grows into is
※ new, and the old is given back only after the copy.
※
※ Compare: **Rust**'s `extend_from_slice`, **Go**'s `append(l, a...)`, **C++**'s
※ `insert(end, first, last)`, and **Python**'s `l += a`, which all grow once and copy as one.

let std := ⎕import("std")

fn sum(v: u16⟦⟧) → u64:
    let s: mut u64 = 0u64
    foreach x := v:
        s ← s + ⎕widen(x, ⌜u64⌝)
    s

@[startup]
fn main(init: std.Init) → u6:
    let l: mut [u16] = [1u16, 2u16]
    let a: mut u16⟦5⟧ = ⟦10u16, 20u16, 30u16, 40u16, 50u16⟧
    a⟦0⟧ ← 11u16
    l ⧺← a
    if #l ≠ 7 ∨ sum(l) ≠ 154u64:
        return 1u6
    ※ Every other element: a step apart, so one at a time.
    l ⧺← a⟦0…5…2⟧
    if #l ≠ 10 ∨ l⟦9⟧ ≠ 50u16 ∨ l⟦8⟧ ≠ 30u16:
        return 2u6
    ※ A slice of the list itself.
    l ⧺← l⟦0…3⟧
    if #l ≠ 13 ∨ l⟦12⟧ ≠ 11u16 ∨ l⟦10⟧ ≠ 1u16:
        return 3u6
    ※ A new list of a list and an array, either way round.
    let m: [u16] = l ⧺ a
    if #m ≠ 18 ∨ m⟦17⟧ ≠ 50u16 ∨ m⟦0⟧ ≠ 1u16:
        return 4u6
    let n: [u16] = a⟦1…3⟧ ⧺ m
    if #n ≠ 20 ∨ n⟦0⟧ ≠ 20u16 ∨ n⟦2⟧ ≠ 1u16:
        return 5u6
    ※ Growing, a hundred times over: the room doubles where it runs out.
    let k: mut [u16] = []
    foreach _ := 0u8…100u8:
        k ⧺← a
    if #k ≠ 500 ∨ sum(k) ≠ 15100u64:
        return 6u6
    ※ Of bytes, which is what the decoder of a format does with its input, past a word.
    let b: mut [u8] = []
    b ⧺← ⎕bytes("seventeen bytes!!")
    b ⧺← ⎕bytes("")
    if #b ≠ 17 ∨ (⎕text(b) ?? "") ≠ "seventeen bytes!!":
        return 7u6
    0u6
