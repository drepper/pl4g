※ pl4g-test: compile=ok opt=0,1
※ pl4g-test: run=native,qemu exit=1
※ pl4g-test: diag=none

※ Four values are wanted at the same time, which is three more than this
※ compiler could hold before there was a register allocator.  They are written
※ back in the reverse of the order they were read, so the one read first is
※ wanted longest, and returning it is what says it was still there.
let a: u6 = 1u6
let b: u6 = 2u6
let c: u6 = 3u6
let d: u6 = 4u6

let wa: mut u6 = 0u6

@[expect(4007)]
let wb: mut u6 = 0u6

@[expect(4007)]
let wc: mut u6 = 0u6

@[expect(4007)]
let wd: mut u6 = 0u6

@[startup, impure]
fn main() → u6:
    let va: u6 = a
    let vb: u6 = b
    let vc: u6 = c
    let vd: u6 = d
    wd ← vd
    wc ← vc
    wb ← vb
    wa ← va
    wa
