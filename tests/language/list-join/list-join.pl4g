※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ `⧺` joins two lists as it joins two strings: one after the other, in room
※ taken from the arena.  What differs is only that a list's elements are as
※ wide as its type says rather than one byte, so the two lengths are in
※ elements and the copy is in bytes -- one multiplication apiece.
※
※ Both sides hold the same type, which today is every list's rule and will
※ later be the case worth not boxing.

@[startup, impure]
fn main() → u8:
    let a: [u8] = [1u8, 2u8, 3u8]
    let b: [u8] = [4u8, 5u8]
    let both: [u8] = a ⧺ b
    ※ a join of a join, whose left side is already in the arena
    let more: [u8] = both ⧺ [6u8]
    ※ joining anything to nothing gives what it was
    let still: [u8] = a ⧺ []
    ※ and elements wider than a byte, where the multiplication matters
    let wide: [u32] = [1u32, 2u32] ⧺ [3u32]
    if #both ≠ 5u64 ∨ #more ≠ 6u64 ∨ #still ≠ 3u64 ∨ #wide ≠ 3u64:
        1u8
    elif total(both) ≠ 15u8:
        2u8
    elif total(more) ≠ 21u8:
        3u8
    elif total(still) ≠ 6u8:
        4u8
    elif widest(wide) ≠ 6u32:
        5u8
    else:
        0u8

fn total(l: [u8]) → u8:
    let found: mut u8 = 0u8
    foreach x := l:
        found ← found + x
    found

fn widest(l: [u32]) → u32:
    let found: mut u32 = 0u32
    foreach x := l:
        found ← found + x
    found
