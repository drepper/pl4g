※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ The bitwise operators over a run, at every width a lane can be and at every
※ length a piece can be.  A machine that has registers holding a run reads the
※ run in one instruction, and which instruction that is depends on how many
※ bytes it covers -- four, eight or sixteen -- so each of the three is here, and
※ each element width is here so that the lanes are counted right.
@[startup]
fn main() → u8:
    let a: u8⟦4⟧ = ⟦1u8, 2u8, 3u8, 4u8⟧
    let b: u8⟦8⟧ = ⟦1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8⟧
    let c: u32⟦4⟧ = ⟦1u32, 2u32, 3u32, 4u32⟧
    let d: u64⟦2⟧ = ⟦1u64, 2u64⟧
    let e: u16⟦2⟧ = ⟦1u16, 2u16⟧
    let ma: u8⟦4⟧ = a | 8u8
    let mb: u8⟦8⟧ = b ^ 1u8
    let mc: u32⟦4⟧ = c & 1u32
    let md: u64⟦2⟧ = d | 16u64
    let me: u16⟦2⟧ = e & 1u16
    if ma⟦0⟧ ≠ 9u8 ∨ ma⟦3⟧ ≠ 12u8:
        1u8
    elif mb⟦0⟧ ≠ 0u8 ∨ mb⟦7⟧ ≠ 9u8:
        2u8
    elif mc⟦0⟧ ≠ 1u32 ∨ mc⟦3⟧ ≠ 0u32:
        3u8
    elif md⟦0⟧ ≠ 17u64 ∨ md⟦1⟧ ≠ 18u64:
        4u8
    elif me⟦0⟧ ≠ 1u16 ∨ me⟦1⟧ ≠ 0u16:
        5u8
    else:
        0u8
