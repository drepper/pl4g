※ A module is found beside the file importing it, read while this one is being
※ compiled, and what it exports is named through the name it was bound to here.
let limits := import("limits")

@[startup]
fn main() → u6:
    ※ what this used to say through the exit status, which is six bits now
    if (limits.ceiling & limits.floor) = 65u8:
        0u6
    else:
        1u6
