※ pl4g-test: compile=error diag=4537
※ pl4g-test: expect-diag 4537 LANG_REF_PLACE_NOT_MUTABLE

※ A field may be written where the record holding it may, which is what the
※ `mut` before the record's type says -- of a variable, of a parameter, and of
※ the record the startup function is handed: `&mut init.io.output` asks for
※ `init: mut std.Init`.

let std := ⎕import("std")

type Point = x : u8 ; y : u8

@[impure]
fn bump(n: &mut u8):
    n⌖ ← n⌖ + 1u8

@[startup, impure]
fn main(init: std.Init) → u6:
    let p: Point = Point(.x ← 1u8, .y ← 2u8)
    bump(&mut p.x)
    ⎕drop(std.Io.print(&mut init.io.output, ⎕bytes("x")) ?? 0)
    0u6
