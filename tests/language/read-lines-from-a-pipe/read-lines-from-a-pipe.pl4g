※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ `std.read_lines` walks a `Reader` a line at a time: each line with the end of
※ line after it, the last one without where the text ends without one, as a
※ view into a buffer the walk keeps -- good until the next turn.  An empty line
※ is a line, and is the end of line alone.  A pipe here, so that nothing is left on a disk: what goes in at one end
※ comes out of the other, and closing the writing end is what ends the text.
※
※ Compare: **C**'s `getline` into one buffer, which this is; **Python**'s
※ iterating a file, which keeps the end of line too; **Go**'s `bufio.Scanner`,
※ which drops it; **Rust**'s `BufRead::lines`, which drops it and allocates a
※ `String` per line.

let std := ⎕import("std")

fn filled(out: std.io.Writer) → u6:
    let w: mut std.io.Writer = out
    defer std.io.Writer.close(w)
    match std.write_sync(&mut w, ⎕bytes("one\ntwo two\n\nfour")):
        u64 ¤size(n):
            if n = 17: 0u6 else: 1u6
        ⊥:
            2u6

fn counted(from: std.io.Reader) → u6:
    let r: mut std.io.Reader = from
    defer std.io.Reader.close(r)
    let lines: mut u64 = 0u64
    let bytes: mut u64 = 0u64
    let fourth: mut u8 = 0u8
    foreach line := std.read_lines(&mut r):
        match line:
            u8⟦⟧(text):
                lines ← lines + 1u64
                bytes ← bytes + ⎕drop(#text)
                if lines = 4u64 ∧ #text = 4: fourth ← text⟦0⟧
            ⊥:
                return 3u6
    if lines = 4u64 ∧ bytes = 17u64 ∧ fourth = 102u8: 0u6 else: 4u6

@[startup, impure]
fn main(init: std.Init) → u6:
    let ends: mut i32⟦2⟧ = ⟦0i32, 0i32⟧
    if ⎕syscall(⎕sc@pipe2, &mut ends⟦0⟧, 0i64) < 0i64:
        return 5u6
    let wrote := filled(std.io.Writer(.fd ← ends⟦1⟧, .ring ← init.io.error.ring))
    if wrote ≠ 0u6:
        std.io.Reader.close(std.io.Reader(.fd ← ends⟦0⟧, .ring ← init.io.error.ring))
        return wrote
    counted(std.io.Reader(.fd ← ends⟦0⟧, .ring ← init.io.error.ring))
