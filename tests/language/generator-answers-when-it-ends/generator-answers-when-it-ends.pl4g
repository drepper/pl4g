※ pl4g-test: compile=ok opt=0,1 run=native,qemu exit=0 diag=none

※ A generator may answer something when it ends, said with `→ T` after what it
※ hands out: its last expression, or `return v`.  A body handing it the walk
※ with `yield ⇉` written where a value is wanted takes that answer once the
※ delegate has given all its turns, which pass straight through -- Python's
※ `x = yield from g()`.  The delegate is never written into a loop, its answer
※ having to be somewhere when it ends.

let std := ⎕import("std")

fn counted(n: u8) ⇉ u8 → u8:
    foreach i := 0u8…n:
        yield i
    n × 10u8

fn summed() ⇉ u8:
    let a: u8 = yield ⇉ counted(2u8)
    let b: u8 = yield ⇉ counted(3u8)
    yield a + b

@[startup]
fn main(init: std.Init) → u6:
    let total: mut u8 = 0u8
    let turns: mut u8 = 0u8
    foreach one := summed():
        total ← total + one
        turns ← turns + 1u8
    if total = 54u8 ∧ turns = 6u8: 0u6 else: ⎕narrow(total, ⌜u6⌝) ?? 63u6
