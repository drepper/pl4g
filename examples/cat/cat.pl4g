※※ cat: copy files, or the standard input, to the standard output.
※※
※※ `-n` numbers every line and `-b` every line that is not empty, `-b` winning
※※ where both are given, as GNU and BSD cat both have it.  The number is six
※※ columns wide and a tab follows it.  A file named `-`, or none at all, is the
※※ standard input; `--` ends the options.  Numbering goes on from one file to
※※ the next, and a line that runs on from the end of one file into the next is
※※ one line.
※※
※※ The text is walked a line at a time with `std.read_lines`, which hands each
※※ line out with its end of line -- the last one without, where the file ends
※※ without one -- so what comes out is what went in, with a number in front of
※※ each line that begins.  A line longer than `std.read_lines` takes (1024
※※ bytes) is reported as the error it hands out, and the file goes no further.
※※ An error is reported by its name in `std.Error` -- `not_found`, `no_buffer` --
※※ which `std.error_name` reads off the enumeration.

let std := ⎕import("std")

※※ What the options asked for, where numbering has got to, and what went wrong
※※ with the last file copied: nought where nothing did.
type State =
    numbered : bool ; blank_too : bool ; count : u64 ; at_start : bool ; error : i32

※※ Write `n` six columns wide and a tab after it.
※※
※※ \return how many bytes went, which is all seven
※※ \raises the number the kernel gave
fn number(out: &mut std.io.Writer, n: u64) → u64 ¤size ? i32:
    let text: mut u8⟦7⟧ = 7 ⍴ 32u8
    text⟦6⟧ ← 9u8
    let left: mut u64 = n
    let at: mut u64 ¤idx = 6
    while at > 0 ∧ (left > 0u64 ∨ at = 6):
        at ← at - 1
        text⟦at⟧ ← 48u8 + (⎕narrow(left % 10u64 ?? 0u64, ⌜u8⌝) ?? 0u8)
        left ← left ÷ 10u64 ?? 0u64
    std.Io.print(out, text)

※※ What went wrong with a write: the number the kernel gave, or nought where
※※ everything went.
fn failure(of: u64 ¤size ? i32) → i32:
    match of:
        ⊥(code): code
        _: 0i32

※※ Copy everything `from` holds to `out` a line at a time, numbering as `before`
※※ says, and answer the state after it: where numbering got to, and in `error`
※※ what went wrong -- nought where nothing did.
※
※ The state is handed in and handed back rather than lent by `&mut`: what is
※ written is this function's own copy, so it changes nothing it did not make and
※ needs no `@[impure]`.  The devices are lent, which is permission to read and
※ write them and nothing more.
fn copied(from: &mut std.io.Reader, out: &mut std.io.Writer, before: State) → State:
    let state: mut State = before
    state.error ← 0i32
    foreach line := std.read_lines(from):
        match line:
            u8⟦⟧(text):
                ※ A line begins where the last one ended; one that runs on from the
                ※ end of the file before is not numbered again.
                let blank: bool = #text = 1 ∧ text⟦0⟧ = 10u8
                if state.at_start ∧ state.numbered ∧ (state.blank_too ∨ ¬blank):
                    state.count ← state.count + 1u64
                    state.error ← failure(number(out, state.count))
                    if state.error ≠ 0i32:
                        return state
                state.error ← failure(std.Io.print(out, text))
                if state.error ≠ 0i32:
                    return state
                state.at_start ← text⟦⎕unit(⎕drop(#text) - 1u64, ⌜idx⌝)⟧ = 10u8
            ⊥(code):
                state.error ← code
                return state
    state

@[startup]
fn main(init: std.Init) → u6:
    let state: mut State = State(.numbered ← false, .blank_too ← true, .count ← 0u64,
                                 .at_start ← true, .error ← 0i32)
    let files: mut u64 = 0u64
    let options: mut bool = true
    foreach arg: str = init.args⟦1…#init.args⟧:
        let bytes: u8⟦⟧ = ⎕bytes(arg)
        if options ∧ arg = "--":
            options ← false
        elif options ∧ #bytes > 1 ∧ bytes⟦0⟧ = 45u8:
            foreach c: u8 = bytes⟦1…#bytes⟧:
                if c = 110u8:
                    state.numbered ← true
                elif c = 98u8:
                    state.numbered ← true
                    state.blank_too ← false
                else:
                    ⎕drop(std.println⌜&mut init.io.error, "cat: invalid option -- '{}'",
                                       ⎕chr(⎕widen(c, ⌜u32⌝))⌝ ?? 0)
                    return 1u6
        else:
            files ← files + 1u64
    if files = 0u64:
        return reported(copied(&mut init.io.input, &mut init.io.output, state).error, "-",
                        &mut init.io.error)
    options ← true
    let excode: mut u6 = 0
    foreach arg: str = init.args⟦1…#init.args⟧:
        let bytes: u8⟦⟧ = ⎕bytes(arg)
        if options ∧ arg = "--":
            options ← false
        elif ¬(options ∧ #bytes > 1 ∧ bytes⟦0⟧ = 45u8):
            if arg = "-":
                state ← copied(&mut init.io.input, &mut init.io.output, state)
                excode ← excode | reported(state.error, arg, &mut init.io.error)
            else:
                match std.fs.cwd().open(arg, ⌜std.io.Reader⌝):
                    std.io.Reader(r):
                        let from: mut std.io.Reader = r
                        defer from.close()
                        state ← copied(&mut from, &mut init.io.output, state)
                        excode ← excode | reported(state.error, arg, &mut init.io.error)
                    ⊥(code):
                        _ ← reported(code, arg, &mut init.io.error)
                        excode ← 1
    excode

※※ Say what went wrong with `name`, where `code` says something did, and answer the
※※ status that comes to.
fn reported(code: i32, name: str, err: &mut std.io.Writer) → u6:
    if code = 0i32:
        return 0u6
    ⎕drop(std.println⌜err, "cat: {}: {}", name, std.error_name(code)⌝ ?? 0)
    1u6
